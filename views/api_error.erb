<div class="card" style="padding: 14px;">
  <div style="font-weight: 700; margin-bottom: 8px;">REST‑API Fehler</div>
  <div class="sub" style="margin-bottom: 12px;">
    <code><%= h(error_message) %></code>
  </div>

  <div class="sub" style="line-height: 1.6;">
