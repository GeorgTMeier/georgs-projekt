<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
%INCLUDE "lsconst.lss"
Use "AddressParser"
Use "StringResources"
Use "MiscContactsLib"
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Function getNumVals(doc As notesdocument, fieldname As String)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim DocWasSaved As Integer
Dim strFieldName As String
Dim strPhoneNumber As String
Dim strPrevFirstName As String
Dim strPrevLastName As String
Dim strPrevMidName As String
Dim pProfile As notesdocument

'Dim doc As notesdocument
Dim beingSaved As Variant
'++LotusScript Development Environment:2:1:getNumVals:1:8
Function getNumVals(doc As notesdocument, fieldname As String)
%REM
	getNumVals = 1
'if multiple values, don't parse	
	ValPhoneNumber = doc.getitemvalue(fieldname)
	If Ubound(ValPhoneNumber) &gt; 0 Then
		getNumVals = 0	
	End If
%END REM
End Function<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Postrecalc(Source As Notesuidocument)
Declare Sub Queryclose(Source As Notesuidocument, Continue As Variant)
Declare Sub NameQuery(doc As notesdocument)
Declare Sub FillInName(doc As notesdocument, FN As String, MI As String, LN As String)
Declare Sub OtherLegacyFields(doc As notesdocument, uidoc As notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
Declare Sub Postmodechange(Source As Notesuidocument)
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim doc As NotesDocument
Dim tmpNotesName As NotesName
Dim tmpString As String
Dim newString() As String
Dim count As Integer
Dim changed As Integer
Dim item As NotesItem
Dim FNHowManyValues As Integer
Dim FNcount As Integer

Dim ViewStrCheck As Integer

Const EditContactMsg = "You cannot edit contacts in the Recent Contacts view."
Const varRCTitle = "Recent Contacts"

'DWA compatibility text
Const dwaHomeTxt = "Home"
Const dwaWork2Txt = "Work 2"
Const dwaWork3Txt = "Work 3"
Const dwaSchoolTxt = "School"

Const SaveMsg1 = "This contact cannot be saved until it is marked as private, to reflect the administrator settings."
Const SaveMsg2 = "This contact cannot be saved until you remove the Mark Private check mark, to reflect the administrator settings."
Const SaveTitle = "HCL Notes"
'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
	On Event Querymodechange From Source Call Querymodechange
	On Event Postrecalc From Source Call Postrecalc
	On Event Queryclose From Source Call Queryclose
	On Event Queryopen From Source Call Queryopen
	On Event Postmodechange From Source Call Postmodechange
	On Event Querysave From Source Call Querysave
End Sub

'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Dim w As New NotesUIWorkspace 
	Dim s As New NotesSession
	Dim item As NotesItem
	Set db = s.CurrentDatabase
	Set uidoc=source
	Set doc = uidoc.document
	locarea=doc.AreaCodeFromLoc
	
	Set item = doc.GetFirstItem("FirstName")
	strPrevFirstName = item.Text
	Set item = doc.GetFirstItem("LastName")
	strPrevLastName = item.Text
	Set item = doc.GetFirstItem("MiddleInitial")
	strPrevMidName = item.Text
	
'if document has been copied from public address book
'it may only have InternetAddress value
	MA = doc.getitemvalue("MailAddress")
	IA = doc.getitemvalue("InternetAddress")
	If ma(0) = "" And IA(0) &lt;&gt; "" Then
		Call doc.replaceitemvalue("MailAddress", IA)
	End If
	
'if contact record is from R7 or previous, need to fill in the FullNameInput field
	Call FillInName(doc, strPrevFirstName, strPrevMidName, strPrevLastName)	
	Call OtherLegacyFields(doc, uidoc)
	
	'iNotes  contact compatibility
	'if confidential contact was created in iNotes  and never saved in Notes, do not show as confidential in Notes client
	Call CheckDWAConf(uidoc, doc)
	
	'checking policy for Private Contacts
	If uidoc.editmode Then
		Dim profile As notesdocument
		Set profile = db.getprofiledocument("DirectoryProfile")
		policyNotLocked = False
		
		If Not (profile Is Nothing) Then
			If Lcase(profile.getitemvalue("Owner")(0)) = Lcase(s.UserName) Then
				If Not CheckPrivatePolicyLocked_Form(s, doc, Profile) 	Then
					policyNotLocked = True
					If doc.isnewnote Or doc.hasitem("IsNewDoc") Then
						Call ActivatePrivateDefaultPolicy(s, db, Profile, dpdoc, doc)
					End If
				End If		
			End If				
			
			If doc.hasitem("$DPLocked") And policyNotLocked = True Then
				Call doc.replaceitemvalue("$DPLocked", "")
			End If
		End If
		
		Call uidoc.refresh  'moved from OtherLegacyFields
	End If
	
	
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
	dpabForm = source.document.getitemvalue("form")	
	If (Not source.editmode And ViewStrCheck &gt; 0) Or source.inpreviewpane Or Lcase(dpabform(0)) = "dpabperson" Then
		Msgbox EditContactMsg, 64, varRCTitle
		continue = False
	End If
	
	
End Sub
'++LotusScript Development Environment:2:2:Postrecalc:1:12
Sub Postrecalc(Source As Notesuidocument)
	Dim doc As NotesDocument
	Dim tmpNotesName As NotesName
	Dim tmpString As String
	Dim newString() As String
	Dim count As Integer
	Dim changed As Integer
	
	Set doc = source.document
	
	FNI = doc.getitemvalue("FullNameInput")
	If FNI(0) = "" Then
		Call doc.replaceitemvalue("FirstName", "")
		Call doc.Replaceitemvalue("MiddleInitial", "")
		Call doc.Replaceitemvalue("LastName", "")
		Call doc.Replaceitemvalue("Title", "")
		Call doc.Replaceitemvalue("Suffix", "")
		Call doc.ReplaceItemvalue("FullName", "")
	End If
	
	Set NABProfile = db.getprofiledocument("DirectoryProfile")
	
	If NABProfile.acceptNameParsing(0) &lt;&gt; "1" Then
		Call NameQuery(doc)	
	End If
	
	First = doc.GetItemValue("FirstName")(0)
	Last = doc.GetItemValue("LastName")(0)
	Middle = doc.GetItemValue("MiddleInitial")(0)
	
	' Check the FullName field, add the current value if necessary	
	Dim item As NotesItem
	Set item = doc.GetFirstItem("FullName")	
	If Middle &lt;&gt; "" Then	
		tmpFull = Trim(First + " " + Middle + " " + Last)
	Else
		tmpFull = Trim(First + " " + Last)
	End If
	
	
'	If Not item.Contains(tmpFull) Then
'		Call item.AppendToTextList(tmpFull)
'	End If
	
	If Not item.Contains(tmpFull) Then
		currentFull = doc.getitemvalue("FullName")
		Dim FNHowManyValues As Integer
		FNHowManyValues = Ubound(currentfull)
		Dim FNcount As Integer
		FNcount = 0
		
		Redim newFullName(FNHowManyValues + 1)
		newFullName(fnCount) = tmpFull
		FNcount = FNcount + 1
		
		For FNcount = 1 To FNHowManyValues+1
			Forall fnNames In currentFull
				newFullName(fnCount) = fnNames
				FNcount = FNcount + 1
			End Forall			
		Next			
		Call doc.replaceitemvalue("FullName", newFullName)
	End If
	
	
	Full = doc.GetItemValue("FullName")
	
	DispPref = doc.getitemvalue("NameDisplayPref")(0)
	changed = 0
	count = 1
	If Last &lt;&gt; "" Then
		fn = doc.getitemvalue("Fullname")
		
		'if the first value in fullname contains a comma, remove it - causes problems in name lookup			
		'(if it's not the first value, then it doesn't cause a problem)		
		Forall x In fn
			commas = Instr(x,",")
			If commas &gt; 0 Then
				x = ""
				Exit Forall
			Elseif commas = 0 Then
				Exit Forall
			End If
		End Forall	
		
		Call doc.replaceitemvalue("fullname", Fulltrim(fn))
		
		
		If doc.getitemvalue("Fullname")(0) = "" Then
			Redim newString(1)
			changed = 1
			If Cstr(DispPref) = "1"  Then
				tmpstring = First + " " + Last
			Else
				tmpstring = Last + ",  " + First
			End If
			newString(0) = tmpstring
%REM					
		Elseif (First &lt;&gt; strPrevFirstName Or Last &lt;&gt; strPrevLastName)  Then
			Redim newString(Ubound(Full) + 1)
			Forall v In Full
				Set tmpNotesName = New NotesName(v)
				tmpString = tmpNotesName.Common
				If Cstr(DispPref) = "1" Then
					If tmpString = strPrevFirstName + " " + strPrevLastName Then
						Changed = 1
						tmpstring =  First + " " + Last + Strright(tmpNotesName.Abbreviated, tmpNotesName.common)
					Elseif tmpString = strPrevFirstName + " " + strPrevMidName + " " + strPrevLastName Then
						Changed = 1
						tmpstring =  First + " " + Middle + " " + Last + Strright(tmpNotesName.Abbreviated, tmpNotesName.common)
					Else
						tmpstring = tmpNotesName.Abbreviated
					End If
				Else
					If tmpString = strPrevLastName + " " + strPrevFirstName Then
						Changed = 1
						tmpstring =  Last + ", " + First + Strright(tmpNotesName.Abbreviated, tmpNotesName.common)
					Elseif tmpString = strPrevLastName + " " + strPrevMidName + " " + strPrevFirstName Then
						Changed = 1
						tmpstring =  Last + ", " + Middle + " " + First + Strright(tmpNotesName.Abbreviated, tmpNotesName.common)
					Else
						tmpstring = tmpNotesName.Abbreviated
					End If
				End If
				newString(count - 1) = tmpstring
				count = count + 1
			End Forall
%END REM
		End If
		strPrevFirstName = First
		strPrevLastName = Last
		strPrevMidName = Middle
		If changed Then
			Call doc.ReplaceItemValue("FullName", newString)
		End If
		
		
	End If
End Sub
'++LotusScript Development Environment:2:2:Queryclose:1:12
Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	Dim doc As Notesdocument
	Set doc = Source.Document
	doc.RemoveItem("Name")
	doc.RemoveItem("ParseFlag")
	If DocWasSaved=True Then    
		Call doc.Save(True,False,True)
	End If
End Sub
'++LotusScript Development Environment:2:2:NameQuery:1:8
Sub NameQuery(doc As notesdocument)
	Dim xT As Integer
	Dim xS As Integer
	
	FNI = doc.getitemvalue("FullNameInput")
	splitFNI = Split(FNI(0))
	
	If doc.hasitem("MiscLabel1") Then
		NameHelperInput = FNI
		Call doc.ReplaceItemValue("NameHelperInput", FNI)
	Else
		NameHelperInput = doc.getitemvalue("NameHelperInput")		
	End If	
	
	xTitle = doc.getitemvalue("Title")
	xSuffix = doc.getitemvalue("Suffix")
	If xTitle(0) &lt;&gt; "" And xTitle(0) &lt;&gt; "0"Then
		xT = 1
	Else
		xT = 0
	End If
	If xSuffix(0) &lt;&gt; "" And xSuffix(0) &lt;&gt; "0" Then
		xS = 1
	Else
		xS = 0
	End If	
	
	If (Ubound(splitFNI) - xT - xS) &gt; 1  And (Lcase(NameHelperInput(0)) &lt;&gt; Lcase(FNI(0))) Then  'show dialog if the name has more than 2 words in it
		Dim uiwork As New notesuiworkspace
		
'		If beingSaved = False Or pProfile.NHSave(0) = "1" Then
		dlg = uiwork.dialogbox("(NameHelper)", True, True, False, False, False, False, "Name Helper", doc, True)			
		If beingSaved = True And NameHelperInput(0) = "" Then
			Call doc.replaceitemvalue("NameHelperInput", FNI)
		End If
'		End If		
	End If
	
	
End Sub
'++LotusScript Development Environment:2:2:FillInName:1:8
Sub FillInName(doc As notesdocument, FN As String, MI As String, LN As String)
	FNI = doc.getitemvalue("FullNameInput")
	
	If Not doc.isnewnote And FNI(0) &lt;&gt; "" Then
		Exit Sub
	End If
	
	strAddrFormat = doc.getitemvalue("$AddressFormat")(0)
	
	strTItle = doc.getitemvalue("Title")(0)
	If strTitle &lt;&gt; "" And strTitle &lt;&gt; "0" Then
		strTitle = strTitle + " "
	Else
		strTitle = ""
	End If
	
	strSuffix =  doc.getitemvalue("Suffix")(0)
	If strSuffix &lt;&gt; "" And strSuffix &lt;&gt; "0" Then
		strSuffix = ", " + doc.getitemvalue("Suffix")(0)		
	Else
		strSuffix = ""
	End If
	
	If mi &lt;&gt; "" Then
		strMI = mi + " "
	End If
	
	
	If sttrAddrFormat &lt;&gt; "6" Then
		Call doc.replaceitemvalue("FullNameInput", strTitle + FN + " " + strMI +  LN + strSuffix)
		Call doc.replaceitemvalue("NameHelperInput", strTitle + FN + " " + strMI +  LN + strSuffix)
	Else
		Call doc.replaceitemvalue("FullNameInput", strTitle + LN + " " + strMI + FN + strSuffix)
		Call doc.replaceitemvalue("NameHelperInput", strTitle + LN + " " + strMI + FN + strSuffix)
	End If	
End Sub
'++LotusScript Development Environment:2:2:OtherLegacyFields:1:8
Sub OtherLegacyFields(doc As notesdocument, uidoc As notesuidocument)
	
	
	strMailAddress = doc.getitemvalue("MailAddress")(0)
	strIntAdd = doc.getitemvalue("InternetAddress")(0)
	Dim nName As New notesName(strMailAddress)
	nNameAB = nName.abbreviated
	
	strEmail1 = doc.getitemvalue("email_1")(0)
	If Not doc.isnewnote And strMailAddress &lt;&gt; "" And strEmail1 = "" Then
		Call doc.replaceitemvalue("email_1", nNameAB)
	Elseif Not doc.isnewnote And strMailAddress = "" And strIntAdd &lt;&gt; "" Then
		Call doc.replaceitemvalue("email_1", strIntAdd)
	End If
	
	'make sure it's a DWA contact (eg if Work1email item exists) and never saved in pernames (eg SavedUpdate &lt;&gt; "1")
	If uidoc.editmode And Not doc.isnewnote And doc.hasitem("Work1Email")  And Not doc.getitemvalue("SavedUpdate")(0) = "1" Then  
		dwaHomeEmail = doc.getitemvalue("HomeEmail")
		dwaWork1Email = doc.getitemvalue("Work1Email")
		dwaWork2Email = doc.getitemvalue("Work2Email")
		dwaSchoolEmail = doc.getitemvalue("SchoolEmail")
		dwaAssistantPhone = doc.getitemvalue("AssistantPhone")
		dwaHome2Phone = doc.getitemvalue("Home2Phone")
		
		If dwaHomeEmail(0) &lt;&gt; "" And doc.getitemvalue("MiscPhone1")(0) = "" Then
			Call doc.replaceitemvalue("MiscPhone1", dwaHomeEmail)
			If doc.getitemvalue("Elabel2")(0) = "" Then
				Call doc.replaceitemvalue("Elabel2", dwaHomeTxt)
			End If
		End If
		If dwaWork1Email(0) &lt;&gt; "" And doc.getitemvalue("MiscPhone2")(0) = "" Then
			Call doc.replaceitemvalue("MiscPhone2", dwaWork1Email)
			If doc.getitemvalue("Elabel3")(0) = "" Then
				Call doc.replaceitemvalue("Elabel3", dwaWork2Txt)
			End If
		End If
		If dwaWork2Email(0) &lt;&gt; "" And doc.getitemvalue("MiscPhone3")(0) = "" Then
			Call doc.replaceitemvalue("MiscPhone3", dwaWork2Email)		
			If doc.getitemvalue("Elabel4")(0) = "" Then
				Call doc.replaceitemvalue("Elabel4", dwaWork3Txt)
			End If			
		End If
		If dwaSchoolEmail(0) &lt;&gt; "" And doc.getitemvalue("Email_5")(0) = "" Then
			Call doc.replaceitemvalue("Email_5", dwaSchoolEmail)		
			If doc.getitemvalue("Elabel5")(0) = "" Then
				Call doc.replaceitemvalue("Elabel5", dwaSchoolTxt)
			End If			
		End If
		
		If dwaAssistantPhone(0) &lt;&gt; "" And doc.getitemvalue("PhoneNumber_8")(0) = "" Then
			Call doc.replaceitemvalue("PhoneNumber_8", dwaAssistantPhone)		
		End If
		
		If dwaHome2Phone(0) &lt;&gt; "" And doc.getitemvalue("PhoneNumber_10")(0) = "" Then
			Call doc.replaceitemvalue("PhoneNumber_10", dwaHome2Phone)		
		End If
		
		'Call uidoc.refresh    &lt;-- Moved to PostOpen
		
	End If
	
	
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	beingSaved = False
	
	Dim uiw As New notesuiworkspace
	Set currentview = uiw.currentview
	
	If currentview Is Nothing Then
		Exit Sub
	Else
		vName = currentview.viewalias		
	End If
	
	ViewStrCheck = Instr(Lcase(vName), Lcase("collab")) 
	
	If source.editmode And ViewStrCheck &gt; 0 Then
		Msgbox EditContactMsg, 64, varRCTitle
		continue = False
	End If
	
End Sub
'++LotusScript Development Environment:2:2:Postmodechange:1:12
Sub Postmodechange(Source As Notesuidocument)
	
	Call FillInName(doc, strPrevFirstName, strPrevMidName, strPrevLastName)
	Call OtherLegacyFields(doc, uidoc)
	
	'iNotes  contact compatibility
	'if confidential contact was created in iNotes  and never saved in Notes, do not show as confidential in Notes client
	Call CheckDWAConf(uidoc, doc)
	
	If source.editmode  Then 
		Dim session As New notessession
		Set dpdoc = session.getUserPolicySettings("", session.username,POLICYSETTINGS_DESKTOP)
		Set uidoc = source
		Set doc = uidoc.document
		
		Call PDFormPostModeChange(uidoc, doc , dpdoc)	
		
	End If
	
End Sub
'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	
	beingSaved = True
	
	source.refresh  
	
	If doc.hasitem("isNewDoc") Then
		Call doc.removeitem("isNewDoc")
	End If
	
	If doc.hasitem("MNote") Then
		Call doc.removeitem("MNote")
	End If
	
	If doc.CompanyName(0) &lt;&gt; ""  Or doc.LastName(0)&lt;&gt; "" Or doc.FullName(0) &lt;&gt;"" Then
		DocWasSaved=True
	End If
	
	If Not doc.isnewnote Then
		'saved contact; need to check desktop policy for locked / enabled private default
		Dim session As New notessession
		Set dpdoc = session.getUserPolicySettings("", session.username,POLICYSETTINGS_DESKTOP)
		Dim dplocked As Variant
		
		If Not dpdoc Is Nothing Then
			Dim privateIndex As Variant
			dpLocked = DPDoc.getitemvalue("$DPLocked")				
			privateIndex = Arraygetindex(dpLocked, "ContactPrivateDefault", 5)		
			
			If Not Isnull(privateIndex) Then
			'policy is locked; inform user if mis-matched
				privateDefaultValue = dpdoc.getitemvalue("ContactPrivateDefault")
				If privateDefaultvalue(0) = "1" And doc.getitemvalue("Confidential")(0) &lt;&gt; "1" Then
					Msgbox saveMsg1, 64, SaveTitle
					continue = False
					docWasSaved = False
				Elseif privateDefaultvalue(0) = "" And doc.getitemvalue("Confidential")(0) &lt;&gt; "" Then
					Msgbox saveMsg2, 64, SaveTitle
					continue = False
					docWasSaved = False
				Elseif privateDefaultvalue(0) = doc.getitemvalue("Confidential")(0)  Then
					Call doc.replaceitemvalue("$DPLocked", dplocked)
				End If		
			Else 
			'not locked; set $DPLocked to null
				Call doc.replaceitemvalue("$DPLocked", "")
			End If
			
		End If
		
	End If
	
End Sub<break/></text></item>
<item name='$$FullNameInput' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Exiting(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Exiting From Source Call Exiting
End Sub

'++LotusScript Development Environment:2:2:Exiting:1:12
Sub Exiting(Source As Field)
	Dim uiw As New notesuiworkspace
	Call uiw.currentdocument.refresh
End Sub<break/></text></item>
