<item name='$DBScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Explicit


'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidatabase)
Declare Sub Postdocumentdelete(Source As Notesuidatabase)
Declare Sub Querydocumentdelete(Source As Notesuidatabase, Continue As Variant)
Declare Function AccountDeletionExtension(collection As NotesDocumentCollection, accDoc As NotesDocument)
Declare Function ValidateAccountDoc(doc As notesdocument) As String
Declare Sub RemoveDocs(source As NotesUIDatabase,dc As notesDocumentcollection)
Declare Sub RemoveAccountDoc(doc As NotesDocument)
Declare Sub CreateDefaultPersonalAddressBookProfile	

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim ws As NotesUIWorkspace
Dim uidoc As NotesUIDocument
Dim session As NotesSession
Dim db As NotesDatabase
Dim qdoc As NotesDocument
Dim profile As NotesDocument
Dim Answer As String

'[Translation Begin]
Const PREVENT_CERTIFICATE_DELETE="Your administrator has prevented the deletion of one or more of the selected document(s)."
Const DocPreviewTitle = "Delete"
Const DocPreviewMessage = |The document could not be deleted because you currently have the same document open in the Preview Pane.  
This open document will be closed so it can be deleted from the current view.|


Const DelRC = "You cannot delete recent contacts."
Const DelRCTitle = "Recent Contacts"

Const ACCT_STR1 = "You cannot delete server managed account documents."
Const ACCT_STR2 = "Delete Error"
'[Translation End]






'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDATABASE
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
	On Event Postdocumentdelete From Source Call Postdocumentdelete
	On Event Querydocumentdelete From Source Call Querydocumentdelete
End Sub


'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidatabase)
	On Error Goto Finish
	
	Set session = New NotesSession
	Set db = session.CurrentDatabase   
	Set ws = New NotesUIWorkspace
	
	Set profile=db.GetProfileDocument("DirectoryProfile")
	If profile.Owner(0)="" Then
		Call CreateDefaultPersonalAddressBookProfile
	End If
	Exit Sub
	
Finish:
	Print ""
	Exit Sub
End Sub

'++LotusScript Development Environment:2:2:Postdocumentdelete:1:12
Sub Postdocumentdelete(Source As Notesuidatabase)
	Dim removedb As New NotesDatabase ("","")
	Dim doc As NotesDocument
	Dim collection As NotesDocumentCollection
	Dim flag As Variant
	On Error Goto ErrorRoutine
	
	Set collection = source.documents		
	Set doc = collection.GetFirstDocument
	
	While Not(doc Is Nothing)
		If doc.GetItemValue("Type")(0)="Account"  And doc.GetItemValue("AccountFileName")(0) &lt;&gt;"" Then
			flag = removedb.Open("", doc.GetItemValue("AccountFileName")(0))
			If flag = True Then
				Call removedb.remove
				Set removedb = New NotesDatabase("","")
			End If
		End If
		Set doc = collection.GetNextDocument(doc)			
	Wend
	
'	Call ws.ViewRefresh
	Exit Sub
	
ErrorRoutine:
	Messagebox "PostDocDelete: " &amp; Error$ &amp; " " &amp; Erl
	Exit Sub
	
End Sub

'++LotusScript Development Environment:2:2:Querydocumentdelete:1:12
Sub Querydocumentdelete(Source As Notesuidatabase, Continue As Variant)
	
	On Error Goto ErrorTrap
	
	Dim uiview As NotesUIView
	Dim uidoc As NotesUIDocument
	Dim collection As NotesDocumentCollection
	Dim doc As NotesDocument
	
	Dim strViewName As String
	Dim e As Variant
	Dim SoftDelEnabled As Integer
	
	Set	uiview = ws.currentview
	
	If Not(uiview Is Nothing) Then
		strViewName=uiview.ViewAlias
		Set collection = source.documents
	End If
	
	'is softdeletes enabled...
	SoftDelEnabled = False
	e =  Evaluate( "@IsSoftDeleteEnabled")
	If Isarray(e) Then
		If e(0) = 1 Then
			SoftDelEnabled = True			
		End If
	End If	
	
	' Accounts documents needs special handling if files are attached. 
	
	If Strcompare(strViewName, "Accounts")  = 0 Then  'dont
		Set qdoc = New NotesDocument(db)
		Dim nextdoc As NotesDocument
		Set collection = source.documents		
		Set doc = collection.GetFirstDocument
		
		While Not(doc Is Nothing)
			Set nextdoc = collection.GetNextDocument(doc)
			If doc.Getitemvalue("IS_SERVER_MANAGED")(0) = 1 Then
				Msgbox ACCT_STR1, 16,ACCT_STR2
				Continue = False
				Exit Sub
			End If	
			If doc.GetItemValue("Type")(0)="Account"  And doc.GetItemValue("AccountFileName")(0) &lt;&gt;"" Then
				If qdoc.GetItemValue("Answer")(0) &lt;&gt; "2"  And qdoc.GetItemValue("Answer")(0) &lt;&gt; "0" Then
					Call qdoc.ReplaceItemValue("Name", doc.GetItemValue("AccountName")(0))
					Call qdoc.ReplaceItemValue("FileName", doc.GetItemValue("AccountFileName")(0))
					Call ws.DialogBox("(DeleteAccounts)", True, True, True,False, False, False, "Delete Accounts", qdoc, True, True)
				End If
				
				If SoftDelEnabled = False Then
					If qdoc.GetItemValue("answer")(0) = "0" Then
						Continue = False
					End If
					Exit Sub
				End If
' Soft delete is enabled				
				If qdoc.GetItemValue("answer")(0) = "0" Then
					Continue = False
					Exit Sub
				Elseif qdoc.GetItemValue("answer")(0) = "2" Then
					Call RemoveDocs(source, collection)
					Call ws.viewrefresh
					Continue = False
					Call AccountDeletionExtension(collection,Nothing)
					Exit Sub
				Else
					Call AccountDeletionExtension(Nothing, doc)
					Call RemoveAccountdoc(doc)	
					Continue = False
				End If
			Else
				If SoftDelEnabled = True Then
					Call RemoveAccountDoc(doc)
				End If
			End If			
			Set doc = nextdoc	
			If SoftDelEnabled = True Then continue = False	
		Wend		
		Call ws.viewrefresh
		Exit Sub
	End If
	
	If SoftDelEnabled = True Then
		Call RemoveDocs(source, collection)
		continue = False
		Call ws.ViewRefresh
		Exit Sub
	End If
	
ErrorTrap:
	If Cstr(Err) &lt;&gt; "0" Then Print (Cstr(Err) &amp; " " &amp; Error$)
	Exit Sub
End Sub

'++LotusScript Development Environment:2:1:AccountDeletionExtension:1:8
Function AccountDeletionExtension(collection As NotesDocumentCollection, accDoc As NotesDocument)
	Dim removedb As New NotesDatabase ("","")
	Dim doc As NotesDocument
	'Dim collection As NotesDocumentCollection
	Dim flag As Variant
	On Error Goto ErrorRoutine
	
	If Not(accDoc Is Nothing) Then
		If accDoc.GetItemValue("Type")(0)="Account"  And accDoc.GetItemValue("AccountFileName")(0) &lt;&gt;"" Then
			flag = removedb.Open("", accDoc.GetItemValue("AccountFileName")(0))
			If flag = True Then
				Call removedb.remove
				Set removedb = New NotesDatabase("","")
				Exit Function
			End If
		End If
	End If
	'Set collection = source.documents	
	
	If collection Is Nothing Then Exit Function
	
	Set doc = collection.GetFirstDocument
	
	While Not(doc Is Nothing)
		If doc.GetItemValue("Type")(0)="Account"  And doc.GetItemValue("AccountFileName")(0) &lt;&gt;"" Then
			flag = removedb.Open("", doc.GetItemValue("AccountFileName")(0))
			If flag = True Then
				Call removedb.remove
				Set removedb = New NotesDatabase("","")
			End If
		End If
		Set doc = collection.GetNextDocument(doc)			
	Wend
	
'	Call ws.ViewRefresh
	Exit Function
	
ErrorRoutine:
	Messagebox "PostDocDelete: " &amp; Error$ &amp; " " &amp; Erl
	Exit Function
End Function

'++LotusScript Development Environment:2:1:ValidateAccountDoc:1:8
Function ValidateAccountDoc(doc As notesdocument) As String
	Set qdoc = New NotesDocument(db)
	If doc.GetItemValue("Type")(0)="Account"  And doc.GetItemValue("AccountFileName")(0) &lt;&gt;"" Then
		If qdoc.GetItemValue("Answer")(0) &lt;&gt; "2"  And qdoc.GetItemValue("Answer")(0) &lt;&gt; "0" Then
			Call qdoc.ReplaceItemValue("Name", doc.GetItemValue("AccountName")(0))
			Call qdoc.ReplaceItemValue("FileName", doc.GetItemValue("AccountFileName")(0))
			Call ws.DialogBox("(DeleteAccounts)", True, True, True,False, False, False, "Delete Accounts", qdoc, True, True)
		End If		
		ValidateAccountDoc = qdoc.GetItemValue("answer")(0)
	End If
End Function

'++LotusScript Development Environment:2:2:RemoveDocs:1:8
Sub RemoveDocs(source As NotesUIDatabase,dc As notesDocumentcollection)
	
	On Error Goto Errorroutine
	
	Dim ws As New notesuiworkspace
	Dim note As NotesDocument
	Dim notePlaceHolder As NotesDocument
	Dim noteid As String
	Dim accountFlag As String
	Dim noDeleteFlag As Boolean
	
	noDeleteFlag= False 'flag used to prevent deletion of notes with ServerCopyUnid=1
	
	If Not(dc Is Nothing) Then
		Set note = dc.GetFirstdocument
	Else
' If collection document from view is nothing then probably a document is opened
		Set note = ws.currentdocument.document
		If Not(note Is Nothing) Then
' Check if its an account doc for special handling if files are present
			accountFlag = ValidateAccountDoc(note) 
			If accountFlag = "0" Then
				Exit Sub
			Elseif accountFlag = "1" Or accountFlag = "2" Then
				Call AccountDeletionExtension(Nothing, note)
			End If
			
			Set notePlaceHolder = note
			If notePlaceHolder.IsUIDocOpen Then
				noteid = notePlaceHolder.noteid
				Delete notePlaceHolder			
				Set notePlaceHolder = ws.CurrentDatabase.database.getdocumentbyid(noteid)
				If Not (notePlaceHolder.HasItem("ServerCopyUnid")) Then
					notePlaceHolder.remove(True)
				Else
					noDeleteFlag= True
				End If
				Exit Sub
			End If
		End If
	End If
	
'Documents selected in a view with or without Preview pane... 
	While Not (note Is Nothing)
		Set notePlaceHolder = note
		Set note = dc.getnextdocument(note)
		If notePlaceHolder.IsUIDocOpen Then
			noteid = notePlaceHolder.noteid
			Delete notePlaceHolder			
			Set notePlaceHolder = ws.CurrentDatabase.database.getdocumentbyid(noteid)
			If Not (notePlaceHolder.HasItem("ServerCopyUnid")) Then
				notePlaceHolder.remove(True)
			Else
				noDeleteFlag= True
			End If
			Call ws.viewrefresh
		Else
			If Not (notePlaceHolder.HasItem("ServerCopyUnid")) Then
				notePlaceHolder.remove(True)
			Else
				noDeleteFlag= True
			End If
			Call ws.viewrefresh
		End If		
	Wend	
	
	If noDeleteFlag= True Then
		Msgbox PREVENT_CERTIFICATE_DELETE,48,"HCL Notes Warning"
	End If
	
	Exit Sub	
	
ErrorRoutine:
	If Err = 4241 Then
		Messagebox DocPreviewMessage, 48, DocPreviewTitle
		Exit Sub
	End If
	
	Exit Sub
	
End Sub

'++LotusScript Development Environment:2:2:RemoveAccountDoc:1:8
Sub RemoveAccountDoc(doc As NotesDocument)
	On Error Goto Errorroutine
	
	Dim ws As New notesuiworkspace
	Dim note As NotesDocument
	Dim notePlaceHolder As NotesDocument
	Dim noteid As String
	
	If Not(doc Is Nothing) Then
		Set note = doc
	Else
' If collection document from view is nothing then probably a document is opened
		Set note = ws.currentdocument.document
		If Not(note Is Nothing) Then
			Set notePlaceHolder = note
			If notePlaceHolder.IsUIDocOpen Then
				noteid = notePlaceHolder.noteid
				Delete notePlaceHolder			
				Set notePlaceHolder = ws.CurrentDatabase.database.getdocumentbyid(noteid)
				notePlaceHolder.remove(True)
				Exit Sub
			End If
		End If
	End If
	
'Documents selected in a view with or without Preview pane... 	
	Set notePlaceHolder = note
	If notePlaceHolder.IsUIDocOpen Then
		noteid = notePlaceHolder.noteid
		Delete notePlaceHolder			
		Set notePlaceHolder = ws.CurrentDatabase.database.getdocumentbyid(noteid)
		notePlaceHolder.remove(True)
		Call ws.viewrefresh
	Else
		notePlaceHolder.remove( True)
		Call ws.viewrefresh
	End If		
	
	Exit Sub	
	
ErrorRoutine:
	If Err = 4241 Then
		Messagebox DocPreviewMessage, 48, DocPreviewTitle
		Exit Sub
	End If	
End Sub

'++LotusScript Development Environment:2:2:CreateDefaultPersonalAddressBookProfile:1:8
Sub CreateDefaultPersonalAddressBookProfile	
	On Error Goto ErrorRoutine
'the global variable "profile" is a profile document already
'we need to add the fields to it
	
	Call profile.ReplaceItemValue("Owner", session.Username)
	
	Call profile.ReplaceItemValue("Form", "DirectoryProfile")
	Call profile.ComputeWithForm(False, False)
	
	Call profile.Save(True,True,True)
	Exit Sub
	
ErrorRoutine:
	Messagebox "CreateDefaultProf: " &amp; Error$ &amp; " " &amp; Erl
	Exit Sub
	
End Sub<break/></text></item>
