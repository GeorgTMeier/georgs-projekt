<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Querysave From Source Call Querysave
	On Event Postopen From Source Call Postopen
	On Event Queryopen From Source Call Queryopen
End Sub

'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim w As New NotesUIWorkspace 
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim doc As NotesDocument
	Set db = s.CurrentDatabase
	Dim uidoc As notesuidocument
	Set uidoc=w.currentdocument
	Set doc = uidoc.document
	Dim PkName As NotesName
	Dim userName As NotesName
	
'Begin DNT
	
	'&lt;TypeAhead&gt;
	
	Call doc.replaceitemvalue("$Loc_Tabs1", 0)
	
	ServerFirstCheckbox = doc.ShowServerAddressesFirst(0)
	MailAddr = doc.MailAddressing(0)
	
	If MailAddr = "3" Then
		Call s.SetEnvironmentVar("TypeaheadShowServerFirstDefault", "1", True)
		Call s.SetEnvironmentVar("locDD", "1")  'for dspMailAddressing 
		
		If ServerFirstCheckbox = "1" Then
			Call s.SetEnvironmentVar("TypeaheadShowServerFirst", "1", True)
			Call s.SetEnvironmentVar("locCB", "1")
		Else
			Call s.SetEnvironmentVar("TypeaheadShowServerFirst", "", True)
			Call s.SetEnvironmentVar("locCB", "")   'for dspShowServerAddressesFirst
		End If		
	Else
		Call s.SetEnvironmentVar("TypeaheadShowServerFirstDefault", "", True)
		Call s.SetEnvironmentVar("locDD", "") 
		Call s.SetEnvironmentVar("TypeaheadShowServerFirst", "", True)
		Call s.SetEnvironmentVar("locCB", "")		
	End If
	
	'\\ &lt;TypeAhead&gt;
	
	If doc.ProxyFlag(0) = "1" Then
		doc.Proxy_FTP=doc.Proxy_HTTP(0)
		doc.Proxy_Gopher=doc.Proxy_HTTP(0)
		doc.Proxy_SSL=doc.Proxy_HTTP(0)
	End If
	
	If doc.GetItemValue("Proxy_Password")(0) &lt;&gt; "" Or doc.GetItemValue("SametimeProxyPassword")(0) &lt;&gt; "" Then
		Set PkName = New NotesName(doc.GetItemValue("ProxyAuthor")(0))
		Call doc.ReplaceItemValue("PublicEncryptionKeys",PkName.Abbreviated)
	End If
	
	ImailAddr = doc.GetItemValue("ImailAddress")(0)
	If ( ImailAddr &lt;&gt; strImailAddress) Then
		Set userName = New NotesName(s.UserName)
		Call doc.ReplaceItemValue("ImailAddressUpdatedBy", userName.Canonical)
		strImailAddress = ImailAddr
'		Call doc.save(True, False)
	End If
	
	Dim flagHasSTproxyPassword As Boolean
	flagHasSTproxyPassword = False
	If doc.getitemvalue("SametimeProtocol")(0) = "3" And doc.getitemvalue("SametimeProxyType")(0) &lt;&gt; "0" Then
		flagHasSTproxyPassword = True
	Else
		Call doc.replaceitemvalue("SametimeProxyUsername", "")
		Call doc.replaceitemvalue("SametimeProxyPassword", "")		
	End If 
	
	If doc.getitemvalue("ProxyAuthenticationFlag")(0) = "" Then
		Call doc.replaceitemvalue("Proxy_LoginName", "")
		Call doc.replaceitemvalue("Proxy_Password", "")		
		Set flagItem=doc.getfirstitem("PublicEncryptionKeys")
		If Not flagitem Is Nothing Then
			Call doc.removeitem("PublicEncryptionKeys")
		End If
	End If
	Call doc.replaceitemvalue("Form", "Location")
	
	'Add ini var if New Location and no Internet Address
	If (source.IsNewDoc And ImailAddr="") Then
		s.SetEnvironmentVar "NewLocation","1",True
	End If
	
'End DNT
	
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	
'BEGIN_DO_NOT_TRANSLATE
	
	Dim item As NotesItem
	Set doc = source.document	
	
	If Not Source.IsNewDoc Then	
		Set item = doc.GetFirstItem("ImailAddress")
		strImailAddress = item.Text
		Call doc.replaceitemvalue("oldloctype", LocationType)
	End If	
	
'TYPEAHEAD
	If doc.getitemvalue("$Loc_Tabs1")(0) = 3 Then  'is set to 3 in contacts preferences link
		If doc.name(0) &lt;&gt; "" Then
			Call source.refresh				
		End If			
	End If	
	
	'new or existing locations; get typeahead ini values
	Dim s As New notessession
	Dim tOptionVar As String
	Dim tAddressingVar As String
	tOptionVar = s.getenvironmentstring("TypeaheadShowServerFirst", True)
	tAddressingVar = s.getenvironmentstring("TypeaheadShowServerFirstDefault", True)
	
	'These ini vars need to be set so we can use them in the Location form
	Call s.SetEnvironmentVar("locCB", tOptionVar)   'for dspShowServerAddressesFirst
	Call s.SetEnvironmentVar("locDD", tAddressingVar)  'for dspMailAddressing 
	
	If doc.LocationType(0) &lt;&gt; "3" And tAddressingVar = "1"  And doc.MailAddressing(0) &lt;&gt; "3" Then
		Call doc.replaceitemvalue("MailAddressing", "3")
		If doc.name(0) &lt;&gt; "" Then
			Call source.refresh
		End If
	Elseif doc.LocationType(0) &lt;&gt; "3" And tAddressingVar = "0"  And doc.MailAddressing(0) = "3" Then
		Call doc.replaceitemvalue("MailAddressing", "2")
		If doc.name(0) &lt;&gt; "" Then
			Call source.refresh
		End If
	Elseif doc.LocationType(0) &lt;&gt; "3" And tAddressingVar = ""  And doc.MailAddressing(0) = "3" Then		
		Call doc.replaceitemvalue("MailAddressing", "2")
		If doc.name(0) &lt;&gt; "" Then
			Call source.refresh
		End If		
	End If
	
	If doc.LocationType(0) &lt;&gt; "3" And tOptionVar = "1" And doc.MailAddressing(0) = "3" Then
		Call doc.replaceitemvalue("ShowServerAddressesFirst", "1")	
	Elseif doc.LocationType(0) &lt;&gt; "3" And tOptionVar = "0"  Then
		Call doc.replaceitemvalue("ShowServerAddressesFirst", "")	
	Elseif doc.LocationType(0) &lt;&gt; "3" And tOptionVar = ""  Then
		Call doc.replaceitemvalue("ShowServerAddressesFirst", "")	
	End If
	
'/End Typeahead
	
'END_DO_NOT_TRANSLATE	
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	
	Dim s As New NotesSession		
	
	If Not Source.IsNewDoc Then		
		'WebRetriever=0 is no longer avail. chocie
		If Source.Document.GetItemValue("WebRetriever")(0)="0" Then			
			If s.Platform = "Macintosh" Then   'DNT
				Call source.Document.ReplaceItemValue("WebRetriever", "10")			
			Elseif s.Platform&lt;&gt;"linux" Then   'DNT
				Call source.Document.ReplaceItemValue("WebRetriever", "2")
			Else
				Call source.Document.ReplaceItemValue("WebRetriever", "9")
			End If
		End If
		
		If Source.Document.ReplicationEnabled(0)="" Then
			If Source.Document.Enabled(0)="1" Then
				Source.Document.ReplicationEnabled="1"
			End If
		End If
	End If
	
	'Check Desktop Policy for locked items
	Dim desktopPolicyDoc As notesdocument	
	Set desktopPolicyDoc = s.GetUserPolicySettings("", s.username,POLICYSETTINGS_DESKTOP)	
	Dim db As notesdatabase
	Set db = s.currentdatabase
	Call locPolicy	(desktopPolicyDoc, db)
	
End Sub<break/></text></item>
