perpub="1" &amp; loctype = "0";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_loc_LAN");
perpub="1" &amp; loctype = "1" &amp; tablename = "";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_loc_NotesDial");
