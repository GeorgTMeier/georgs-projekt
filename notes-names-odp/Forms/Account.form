<item name='$WINDOWTITLE' sign='true'><formula>@If(@IsNewDoc;"New Account";"Account: "+AccountName)</formula></item>
<item name='$Flags'><text>C</text></item>
<item name='$DesignerVersion' sign='true'><text>8.5.3</text></item>
<item name='$ConflictAction' sign='true'><text>1</text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66
Option Public

'++LotusScript Development Environment:2:5:(Forward):0:1

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim sOriginalAccountProtocol As String
Dim sOriginalAccountServer As String
<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Function CreateDatabase(strTemplateFile As String, strOutput As String, strTitle As String) As Integer
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim strTitle As String


'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
	On Event Querysave From Source Call Querysave
	On Event Querymodechange From Source Call Querymodechange
End Sub

'++LotusScript Development Environment:2:1:CreateDatabase:1:8
Function CreateDatabase(strTemplateFile As String, strOutput As String, strTitle As String) As Integer
	Dim dbTemplate As NotesDatabase
	Dim dbOutput As NotesDatabase
	
	' Open up the template
	Set dbTemplate = New NotesDatabase("", strTemplateFile)
	If Not(dbTemplate.IsOpen) Then
		CreateDatabase = False
		Exit Function
	End If
	
	
	Set dbOutput = New NotesDatabase("", strOutput)
	If (dbOutput.IsOpen) Then          
		CreateDatabase = True
		Exit Function
	End If
	
	Set dbOutput = dbTemplate.CreateFromTemplate("", strOutput, True)
	dbOutput.Title=strTitle
	
	CreateDatabase = (dbOutput.IsOpen)
End Function
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Dim  doc As NotesDocument
	
	Set uidoc=Source
	Set doc=source.Document	
	
	sOriginalAccountProtocol=doc.GetItemValue("AccountProtocol")(0)
	sOriginalAccountServer=doc.GetItemValue("AccountServer")(0)
	If uidoc.IsNewDoc Then
		Call doc.ReplaceItemValue("AccountPFlag",doc.GetItemValue("AccountProtocol"))
		Call doc.ReplaceItemValue("AccountSFlag",doc.GetItemValue("SSLStatus"))
	End If
	If doc.HasItem("IS_SERVER_MANAGED") Then
		uidoc.editmode = False
	End If
End Sub
'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim  doc As NotesDocument
	Dim checkdoc As NotesDocument
	Dim ProtocolType As String
	Dim strProtocolString As String
	Dim bSuccess As Integer
	Dim vAccountName As Variant
	Dim strFileName As String
	Dim ws As New NotesUIWorkspace
	Dim vValid As Variant	
	Dim dc As NotesDocumentCollection
	Dim db As NotesDatabase
	Dim session As New NotesSession
	
	
	Set db = session.CurrentDatabase
	Set view = db.GetView("($Accounts)")
	Set uidoc=Source
	Set doc=source.Document	
	Call view.refresh
	Set dc= view.GetAllDocumentsByKey(doc.GetItemValue("AccountName")(0), True)
	
	On Error Goto RefreshError
	Call uidoc.refresh
	
	If dc.count &gt;0 Then
		Set checkdoc=dc.GetFirstDocument
		If checkdoc.NoteID &lt;&gt; doc.NoteID Then
			Messagebox "An Account with this name already exists.  Please choose a different Account name."
			Continue=False
			Exit Sub
		End If
	End If
	
	vValid=Evaluate(|@Contains(AccountName;"\\":"/":":":"+":"=":"*":"&lt;":"&gt;":"\"":";":"?":",":"[":"]":"{":"}":"\'":"(":")")|,doc)
	If vValid(0)=1 Then
		Call uidoc.refresh
		Continue=False
		Exit Sub
	Else 
		vValid=Evaluate({@Contains(AccountName;"|")},doc)
		If vValid(0)=1 Then
			Call uidoc.refresh
			Continue=False
			Exit Sub
		End If
	End If
	
	If doc.GetItemValue("AccountName")(0) = "" Then
		Call uidoc.refresh
		Exit Sub
	End If
	
	vAccountName=Evaluate(|@ReplaceSubString(AccountName;" ":".";"")|,doc)
	
	strFileName=vAccountName(0)
	If Len(strFileName) &gt; 8 Then
		strFileName=Left(strFileName, 8)+".nsf"
	Else
		strFileName=strFileName+".nsf"
	End If
	
	strTitle=doc.GetItemValue("AccountName")(0)
	
	ProtocolType=doc.GetItemValue("AccountProtocol")(0)
	
	If doc.GetItemValue("AccountFileName")(0) &lt;&gt; "" Then
		If (ProtocolType &lt;&gt; sOriginalAccountProtocol)  And Not doc.IsNewNote Then 
			Set dbOutput = New NotesDatabase("",doc.GetItemValue("AccountFileName")(0))
			If dbOutput.IsOpen And ProtocolType &lt;&gt; "6" Then
				Call dbOutput.Remove
				Call doc.ReplaceItemValue("AccountFileName", "")
			End If
		End If	
	End If
	
	Select Case ProtocolType
	Case "2"
		If doc.GetItemValue("AccountFileName")(0) = "" Then 
			'Check to see if a db with the same name already exists if this is a new document.
			Set dbOutput = New NotesDatabase("", strFileName)
			If (doc.IsNewNote Or (ProtocolType &lt;&gt; sOriginalAccountProtocol)) And dbOutput.IsOpen Then
				vAccountName=Evaluate(|@Right(@Password(@Text(@Random));"(")|)
				strFileName=Left(vAccountName(0),8)+".nsf"
				Set dbOutput = New NotesDatabase("", strFileName)
				If dbOutput.IsOpen Then
					Messagebox "A proxy database cannot be created because a file with this name already exists.  Please change your Account name."
					Continue=False
					Exit Sub
				End If
			End If
			strProtocolString=" (IMAP)"
			strTitle=strTitle+strProtocolString
			
			bSuccess = CreateDatabase("imapcl5.ntf", strFileName, strTitle)
			If bSuccess = True Then		
				Call doc.ReplaceItemValue("AccountFileName", strFileName)
				Call doc.ReplaceItemValue("IMAPFirstOpen", "1")
				Call ws.AddDatabase("", strFileName)
			Else
				Print "Error: Mail (IMAP) template does not exist."
				Continue=False
			End If
		End If
	Case "3"
		If doc.GetItemValue("AccountFileName")(0) = "" Then
			'Check to see if a db with the same name already exists if this is a new document.
			Set dbOutput = New NotesDatabase("", strFileName)
			If (doc.IsNewNote Or (ProtocolType &lt;&gt; sOriginalAccountProtocol)) And dbOutput.IsOpen Then
				vAccountName=Evaluate(|@Right(@Password(@Text(@Random));"(")|)
				strFileName=Left(vAccountName(0),8)+".nsf"
				Set dbOutput = New NotesDatabase("", strFileName)
				If dbOutput.IsOpen Then
					Messagebox "A proxy database cannot be created because a file with this name already exists.  Please change your Account name."
					Continue=False
					Exit Sub
				End If
			End If
			strProtocolString=" (NNTP)"
			strTitle=strTitle+strProtocolString
			bSuccess = CreateDatabase("nntpcl6.ntf", strFileName, strTitle)
			If bSuccess = True Then
				Call doc.ReplaceItemValue("AccountFileName",strFileName)
				Call ws.AddDatabase("", strFileName)
			Else
				Print "Error: News Articles (NNTP) template does not exist."
				Continue=False
			End If
		End If
	End Select
	Call doc.ReplaceItemValue("OriginalAccountProtocol",sOriginalAccountProtocol)
	Call doc.ReplaceItemValue("OriginalAccountServer",sOriginalAccountServer)
	If doc.GetItemValue("AccountPassword")(0) &lt;&gt; "" Then
		Set PkName = New NotesName(doc.GetItemValue("AccountAuthor")(0))
		Call doc.ReplaceItemValue("PublicEncryptionKeys", PkName.Abbreviated )
	End If
	Exit Sub
RefreshError:
	Continue=False
	Exit Sub
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
	Dim doc As NotesDocument
	Set doc = Source.Document
	
	If Source.EditMode = False And doc.HasItem("IS_SERVER_MANAGED") Then
		Continue = False
	End If
End Sub<break/></text></item>
<item name='$$FormAction7' sign='true'><formula>@If(((AccountProtocol="6") | (AccountProtocol="1"));
@If(OriginalAccountServer !="" &amp; ((AccountProtocol != OriginalAccountProtocol) | (AccountServer != OriginalAccountServer));
@Do(@Command([AddAccountToBriefcase];OriginalAccountServer;OriginalAccountProtocol;AccountLocation;1);
		@Command([AddAccountToBriefcase];AccountServer;AccountProtocol;AccountLocation));
@Do(@Command([AddAccountToBriefcase];AccountServer;AccountProtocol;AccountLocation)));
OriginalAccountProtocol = "6":"1";
@Command([AddAccountToBriefcase];OriginalAccountServer;OriginalAccountProtocol;AccountLocation;1);
"")</formula></item>
<item name='$AppHelpFormula' sign='true'><formula>accountype:=@GetField("AccountProtocol");
@If(
accountype = "1";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_pop");
accountype = "2";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_imon");
accountype = "3";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_nntp");
accountype = "4";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_smtp");
accountype = "5";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_ldap");
accountype = "6";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_acct_imoff");
@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_account"))</formula></item>
<item name='$$AccountProtocol' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Onchange(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Onchange From Source Call Onchange
End Sub

'++LotusScript Development Environment:2:2:Onchange:1:12
Sub Onchange(Source As Field)
	Dim ws As New NotesUIWorkspace
	Dim uidoc As notesuidocument
	
	Set uidoc= ws.CurrentDocument
	If uidoc.Document.GetItemValue("SSLStatus")(0)="2" Then
		If uidoc.Document.GetItemValue("AccountProtocol")(0)&lt;&gt;"4" Then
			Call uidoc.Document.ReplaceItemValue("SSLStatus","0")
		End If
	End If
End Sub<break/></text></item>
<item name='$$SSLStatus' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Onchange(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Onchange From Source Call Onchange
End Sub

'++LotusScript Development Environment:2:2:Onchange:1:12
Sub Onchange(Source As Field)
	Dim ws As New NotesUIWorkspace
	Dim uidoc As notesuidocument
	
	Set uidoc= ws.CurrentDocument
	If uidoc.Document.GetItemValue("SSLStatus")(0)="2" Then		
		Call uidoc.Document.ReplaceItemValue("SSLSiteCerts","1")
	Elseif uidoc.Document.GetItemValue("SSLStatus")(0)="1" Then		
		Call uidoc.Document.ReplaceItemValue("SSLSiteCerts","0")
	End If
End Sub<break/></text></item>
