<item name='$TITLE'><textlist><text>(AddressPicker)</text><text>AddressPicker</text></textlist></item>
<item name='$INFO' sign='true'>
<rawitemdata type='1'>
hhgBAIAAAAAAgAAAAQABAP///wAAAAAA
</rawitemdata></item>
<item name='$Flags'><text>CD</text></item>
<item name='$DesignerVersion' sign='true'><text>8</text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66
Option Public

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Function strToArray(getString As Variant)
Declare Function FindItemInView(thisRow As Integer)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim sArray As Variant
Dim view As notesview
Dim db As notesdatabase
Dim AlphForm As NotesDocument
Dim ProfileDoc As notesdocument
Dim Pview As Variant

%REM
*** HOW TO SET UP THE ADDRESS PICKER ***

**************************
THESE INSTRUCTIONS ARE FOR  BASIC NOTES ONLY
THEY DO NOT APPLY TO THE STANDARD (ECLIPSE/JAVA) CLIENT
**************************
instructions can be found in (Declarations), located
within the AddressPicker(Form) section, below
%END REM

'++LotusScript Development Environment:2:1:strToArray:1:8
Function strToArray(getString As Variant)
	Dim i As Variant
	
'using -1 in these cases because the array begins with 0, not 1
	
	Redim sArray(Len(getString)-1)
	For i = 1 To Len(getString)
		sArray(i-1) = Mid$(getString, i, 1)
	Next
	
	strToArray = sArray
	
End Function
'++LotusScript Development Environment:2:1:FindItemInView:1:8
Function FindItemInView(thisRow As Integer)
	Dim ws As New notesuiworkspace
	Dim uidb As notesuidatabase
	Dim uiview As notesuiview
	Dim note As notesdocument
	Dim strKey(0) As String
	Dim uidoc As notesuidocument
	Dim AlphList As Variant	
	Dim member As Variant
	
	Set uidb = ws.currentdatabase
	
	Pview = ProfileDoc.Pview
	If pview(0) = "BA" Then
		Msgbox "Alphabetic picker is not supported in this view."
	End If
	
	
	Set view = db.getview(Pview(0))
	
	If uidb Is Nothing Then Exit Function
	
	AlphList = AlphForm.getitemvalue("AlphList")
	
	member = Evaluate(|@GetMembers(AlphList; | &amp; ThisRow &amp; |)|, AlphForm)
	
	strKey(0) = member(0)
	
	Call strToArray(strKey(0))
	
	Forall x In sArray			
		Set note = view.getdocumentbykey(x)
		If Not(note Is Nothing) Then
			Call uidb.openview(Pview(0))
			Set uiview = ws.currentview
			Call uiview.selectdocument(note)
			Call ws.viewrefresh
			Exit Function
		End If		
	End Forall
End Function<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Declare
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Postopen(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:10
%REM 
**************************
THESE INSTRUCTIONS ARE FOR  BASIC NOTES ONLY
THEY DO NOT APPLY TO THE STANDARD (ECLIPSE/JAVA) CLIENT
**************************
HOW TO SET UP THE ADDRESS PICKER
1. On a piece of paper, write down each alphabetical character or groups of characters will be used. 
     An example of a group of characters might be "aeiou".
2.  Count the number of elements
     Each alphabetical charcter (such as "A") or group of characters (such as "AEIOU") would be considered an element
3.  Enter the number of elements as the constant alphNumber below
4.  Type each element, in order, into each picture property as alternate text and caption text.
      Write down the grey number to the right of the LAST picture that contains alternate text
5.  Type each element, in order, into the AlphList text list
     ***The constants MUST reflect the exact elements that you typed into the alternate text in step 3.
     ***The number of elements in the list must not exceed 30 (although it can be any number between 1 and 30).
%END REM


Const alphNumber =  26  'This constant represents the number that you wrote down in step #3 above.
                                        'It MUST be the same as the number of items in the AlphList field


'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Queryopen From Source Call Queryopen
	On Event Querysave From Source Call Querysave
	On Event Postopen From Source Call Postopen
End Sub

'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Dim session As New notessession
	Set db = session.currentdatabase	
	Set view = db.getview("People")
	
	Set ProfileDoc = db.getprofiledocument("PickerView")	
'	ProfileDoc.Pview = "People"
End Sub
'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	continue = False
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Set AlphForm = source.document
	
End Sub<break/></text></item>
