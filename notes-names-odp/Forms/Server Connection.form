<item name='$WINDOWTITLE' sign='true'><formula>@If(@IsNewDoc; "New Server Connection"; @Name([CN];Source) + " to " + @Name([CN];Destination) + " via " + PortName)</formula></item>
<item name='$Flags'><text>C</text></item>
<item name='$DesignerVersion' sign='true'><text>8.5.3</text></item>
<item name='$ConflictAction' sign='true'><text>1</text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Function GetDisplayDriverList() As Variant
Declare Function isMobile As Boolean

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:1:GetDisplayDriverList:1:8
Function GetDisplayDriverList() As Variant
'Begin DNT
	On Error Goto ERROR_HANDLER
	
	Dim oSession	As New NotesSession
	Dim oDb		As NotesDatabase
	
	Dim x			As Integer
	Dim y			As Integer
	Dim DriverList()	As String
	Dim Drivers()		As String
	Dim DisplayList()	As String
	Dim Aliases		As Variant
	
	Set oDb		= oSession.CurrentDatabase
	
	Forall Forms In oDb.Forms
		If Forms.IsSubForm Then
			If (oSession.notesbuildversion &lt; 171 Or (Forms.name &lt;&gt; "$RLANARA")) Then
				If Left(Forms.Name, 5) = "$RLAN" Then
					Redim Preserve DriverList(x)
					Redim Preserve Drivers(x)
					Redim Preserve DisplayList(x)
					Aliases = Forms.Aliases
					DriverList(x) = Aliases(0) &amp; "|" &amp; Aliases(1)
					DisplayList(x) = Aliases(0)
					Drivers(x)= Aliases(1)                    
					x = x + 1
				End If     
			End If
		End If
	End Forall
	
	GetDisplayDriverList = DriverList
	
ROUTINE_EXIT:
	Exit Function
	
ERROR_HANDLER:
	Msgbox "Error " + Cstr(Err()) + ": " + Error() + " -- line " + Cstr(Erl())
	Exit Function
'End DNT	
End Function

'++LotusScript Development Environment:2:1:isMobile:1:8
Function isMobile As Boolean
'Begin DNT
	Dim ses As New notessession, plat$
	plat = Strtoken(ses.Platform, "/", 1)
	isMobile = (Instr("iOS,Android", plat) &gt; 0)
'End DNT
End Function<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Declare

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Onload(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Onload From Source Call Onload
End Sub

'++LotusScript Development Environment:2:2:Onload:1:12
Sub Onload(Source As Notesuidocument)
	Dim ses As New NotesSession
	Dim ask%, count%, count1%, count2%
	Const EnabledLanMsg$ = "The enabled communication ports in your User Preferences differ from those selected in this Connection document.  Do you want to update this connection document?"
	Const ELtitle$ = "Communication Ports"	
	Const PortOrderMsg$ = "The order of the communication ports in User Preferences differs from the port order in this Connection document.  Do you want to update this connection document?"
	Const POtitle$ = "Port Order"
'Begin DNT
	If source.inpreviewpane Or source.isnewdoc Then
		Exit Sub
	End If
	
	Dim uiwork As New notesuiworkspace, uidoc As NotesUIDocument, note As notesdocument
	Set uidoc = uiwork.currentdocument	
	
	Set note = uidoc.document
	Dim xLanPortName As Variant
	Dim xEnabledLan As Variant
	Dim xPortName, xConnType$
	
	xLanPortName = note.getitemvalue("LanPortName")
	xEnabledLan = Evaluate("@GetPortsList([EnabledLAN])")
	xPortName = note.getitemvalue("PortName")
	xConnType = note.getitemvalue("ConnectionType")(0)
	' per DA-1528, don't bother checking active ports on mobile.
	If xConnType = "1" Or xConnType = "9" Or xConnType = "2" Or isMobile Then
		Exit Sub
	End If
	
	'compare current list of lan ports with enabled lan ports from preferences	
	count = 0
	count1 = Ubound(xPortName)
	count2 = Ubound(xEnabledLan)
	If count1 = count2 Then
		Do Until count &gt; count1
			If (xPortName(count) &lt;&gt; xEnabledLan(count)) Then
				ask = uiwork.prompt(PROMPT_YESNO, POtitle$, PortOrderMsg$, "")
				If ask = 1 Then
					Call note.replaceitemvalue("LanPortName", xEnabledLan)
					Call note.replaceitemvalue("PortName", xEnabledLan)
					Call note.save(False,False)
					uidoc.close
					Call uiwork.viewrefresh
					Exit Sub
				Else
					Exit Sub
				End If
				
			End If
			count = count+1		
		Loop	
	Else
		ask = uiwork.prompt(PROMPT_YESNO, ELtitle$, EnabledLanMsg$, "")
		If ask = 1 Then
			Call note.replaceitemvalue("LanPortName", xEnabledLan)
			Call note.replaceitemvalue("PortName", xEnabledLan)
			Call note.save(False,False)
			uidoc.close
			Call uiwork.viewrefresh
			Exit Sub
		Else
			Exit Sub
		End If	
	End If
	
'End DNT
End Sub<break/></text></item>
<item name='$AppHelpFormula' sign='true'><formula>contype:=@GetField("ConnectionType");
tablename := @GetFocusTable([TableName]);
row := @GetFocusTable([CellRow]);
@If(
tablename = "NetworkDial_subf";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_servcon_netdial");
tablename = "ServCon_Adv";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_servcon_adv");
(contype = "2" : "9") &amp; tablename != "ServCon_Adv";@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_servcon_passhunt");
@Command([OpenHelpDocument];[ClientHelp];"(Help)";"pernames_f_servcon"))</formula></item>
<item name='$$ConnectionType' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Onchange(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Onchange From Source Call Onchange
End Sub

'++LotusScript Development Environment:2:2:Onchange:1:12
Sub Onchange(Source As Field)
	
	Const ITEM_DISPLAY_DRIVER_LIST	= "DisplayDriverList"
	Const ITEM_CONNECTION_TYPE		= "ConnectionType"
	Const CONNECTION_TYPE_RAS		= "5"
	
	Dim oUIWS 	As New NotesUIWorkspace
	Dim oUIDoc 	As NotesUIDocument
	Dim oDoc		As NotesDocument
	
	On Error Goto ERROR_HANDLER
	
	Set oUIDoc	= oUIWS.CurrentDocument
	Set oDoc		= oUIDoc.Document
	
	If oDoc.GetItemValue(ITEM_CONNECTION_TYPE)(0) = CONNECTION_TYPE_RAS Then
		Call oDoc.ReplaceItemValue(ITEM_DISPLAY_DRIVER_LIST,GetDisplayDriverList())
	End If
	
	Call oUIDoc.Reload
	
ROUTINE_EXIT:
	Exit Sub
	
ERROR_HANDLER:
	Msgbox "Error " + Cstr(Err()) + ": " + Error() + " -- line " + Cstr(Erl())
	Exit Sub
	
End Sub<break/></text></item>
