<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Use "MiscContactsLib"

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Public Function QuickSort(sArray As Variant)
Declare Sub DoQS( sA() As String, bottom As Long, top As Long )
Declare Sub DoInsertSort ( sA() As String, Byval bottom As Long, Byval top As Long )	
Declare Sub setContactGroup(gTitle As String)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim SortedArray As Variant






'++LotusScript Development Environment:2:1:QuickSort:1:8
Public Function QuickSort(sArray As Variant)
	Dim sA() As String    
	Dim j As Long
	Dim bottom As Long
	Dim top As Long
	bottom = Lbound ( sArray )
	top = Ubound ( sArray )
	Redim sA( bottom To top ) As String     
	For j = bottom To top
		sA ( j ) = sArray ( j )
	Next
     ' DoQS does a QuickSort if the Sublist is longer than 10 elements
     ' Thus, when DoQS finishes, all elements are within 10 spots of their correct location.
     ' For lists that are close to being in order, an Insertion Sort is much faster than a QuickSort, so we
     ' run through the whole thing once doing an Insertion Sort to finish tidying up the order.
	Call DoQS( sA, bottom, top )
	Call DoInsertSort ( sA, bottom, top )
	SortedArray = sA
End Function
'++LotusScript Development Environment:2:2:DoQS:1:8
Sub DoQS( sA() As String, bottom As Long, top As Long )
     ' Called by QuickSort
     ' Uses Public variable sA  (array of string)
	Dim length As Long
	Dim i As Long
	Dim j As Long
	Dim Pivot As Long
	Dim PivotValue As String
	Dim t As String
	Dim LastSmall As Long
	length = top - bottom + 1
	
     ' Only do the QuickSort if the sublist is at least 10 items long
	If length &gt; 10 Then
          ' Pivot is chosen approx. halfway through sublist.
          ' This gives us best speed if list is almost sorted already, and is no worse than any
          ' other choice if the list is in random order.
		Pivot = bottom + (length \ 2)   
		
          ' Move PivotValue out of the way
		PivotValue = sA( Pivot )
		sA ( Pivot ) = sA ( bottom )
		sA ( bottom ) = PivotValue
		
          ' LastSmall is the location of the last value smaller than PivotValue
		LastSmall = bottom
		For i = bottom + 1 To top 
			If sA ( i ) &lt; PivotValue Then 
				LastSmall = LastSmall + 1
				t = sA ( i )
				sA ( i ) = sA ( LastSmall )
				sA ( LastSmall ) = t
			End If
		Next
		
          ' Move the PivotValue back
		t = sA ( LastSmall )
		sA ( LastSmall ) = sA ( bottom )
		sA ( bottom ) = t
		Pivot = LastSmall
		
          ' Now sort each side
		Call DoQS ( sA, bottom, Pivot - 1 )
		Call DoQS ( sA, Pivot + 1, top )
	End If
	
End Sub
'++LotusScript Development Environment:2:2:DoInsertSort:1:8
Sub DoInsertSort ( sA() As String, Byval bottom As Long, Byval top As Long )	
	Dim i As Long
	Dim x As Long
	Dim v As String
	Dim Found As Integer
	For i = bottom+1 To top
		x = i
		v = sA (i )
		Do While (sA(x-1) &gt; v)
			sA ( x ) = sA ( x-1 )
			x = x - 1
			If x=0 Then
				Exit Do
			End If
		Loop
		sA (x) = v
	Next
End Sub
'++LotusScript Development Environment:2:2:setContactGroup:1:8
Sub setContactGroup(gTitle As String)
	
	Dim s As New notessession
	Dim uiwork As New notesuiworkspace
	Set note = uiwork.currentdocument.document
	Set db = s.currentdatabase
	Set view = db.getview("($VIMPeople)")
	
	memberList = note.getitemvalue("Members")
	
'check each member to see if there is a contact record for him/her
	
	Forall x In memberList
		Set contactNote = view.getdocumentbykey(x)
		
		
		
	End Forall
	
	
	
	
End Sub<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)
Declare Sub Postsave(Source As Notesuidocument)
Declare Sub Postrecalc(Source As Notesuidocument)
Declare Sub legacyCategory(note As notesdocument)
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Postmodechange(Source As Notesuidocument)
Declare Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim note As notesdocument


Dim ViewStrCheck As Integer

Const EditGroupMsg = "You cannot edit groups in the Recent Contacts view."
Const RecentTitle = "Recent Contacts"

Const errDup = "This group name already exists.  Please enter a different name."
Const errTitle = "Field Contains Incorrect Value"

Const SaveMsgG1 = "This group cannot be saved until it is marked as private, to reflect the administrator settings."
Const SaveMsgG2 = "This group cannot be saved until you remove the Mark Private check mark, to reflect the administrator settings."
Const SaveTitle = "HCL Notes"
'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Querysave From Source Call Querysave
	On Event Postsave From Source Call Postsave
	On Event Postrecalc From Source Call Postrecalc
	On Event Postopen From Source Call Postopen
	On Event Postmodechange From Source Call Postmodechange
	On Event Querymodechange From Source Call Querymodechange
	On Event Queryopen From Source Call Queryopen
End Sub

'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim db As NotesDatabase
	Dim doc As NotesDocument
	Dim profile As NotesDocument
	Dim uidoc As notesuidocument
	Dim flag As String
	Dim w As New NotesUIWorkspace 
	Dim s As New NotesSession
	Set db = s.CurrentDatabase
	Set uidoc=w.currentdocument
	Set doc = uidoc.document
	Set profile=db.GetProfileDocument("DirectoryProfile")
	
	'check if group already exists	
	Dim view As notesview
	Set view = db.GetView("($VIMGroups)")
	Set getGroup = view.getfirstdocument()
	
	If doc.hasitem("isNewDoc") Then
		Call doc.removeitem("isNewDoc")
	End If
	
	While Not getGroup Is Nothing
		getGroupName = getGroup.getitemvalue("ListName")
		getThisName = doc.getitemvalue("ListName")
		
		'make sure the UNID is different before issuing the error
		thisUNID = doc.universalid
		viewUNID = getGroup.universalid
		
		If (Lcase(Trim(getThisName(0))) =  Lcase(Trim(getGroupName(0)))) And thisUNID &lt;&gt; viewUNID Then
			Msgbox errDup, 16, errTitle
			continue = False
			Exit Sub
		End If					
		
		Set getGroup = view.getnextdocument(getGroup)
	Wend
	
	If doc.getitemvalue("tmpNewGroup")(0) = "1"	 Then
		Call doc.replaceitemvalue("tmpNewGroup", "")		
	End If
	
	If profile.GetItemValue("GroupSortDefault")(0)="1" Then
		On Error Resume Next
		'Because canonical names are used in combination with flat names
		'we need to abbreviate the list coming in to do the sort correctly.
		'otherwise, the sort would be off because canonical names internally all start with CN=
		'which causes a flat name to sort before a canonical one even if the first letter of the common name
		'comes before the first letter of the flat name.  To insure correct return values, we canonicalize before
		'we save the note.  We use Evaluate because it is faster to run the @Name on the list then looping 
		'through all possible members and abbreviating them in script.
		FieldList=Evaluate(|@Name([Abbreviate];Members)|,doc)
		Call QuickSort(FieldList)
		Call doc.ReplaceItemValue("Members",SortedArray)
		Call doc.ReplaceItemValue("Members", Evaluate(|@Name([Canonicalize];Members)|,doc))
		Call uidoc.refresh
	End If	
	
	If Not doc.isnewnote Then
		'saved contact; need to check desktop policy for locked / enabled private default
		Dim session As New notessession
		Set dpdoc = session.getUserPolicySettings("", session.username,POLICYSETTINGS_DESKTOP)
		
		If Not dpdoc Is Nothing Then
			
			Dim dplocked As Variant
			Dim privateIndex As Variant
			dpLocked = DPDoc.getitemvalue("$DPLocked")				
			privateIndex = Arraygetindex(dpLocked, "ContactPrivateDefault", 5)		
			
			If Not Isnull(privateIndex) Then
			'policy is locked; inform user if mis-matched
				privateDefaultValue = dpdoc.getitemvalue("ContactPrivateDefault")
				If privateDefaultvalue(0) = "1" And doc.getitemvalue("Confidential")(0) &lt;&gt; "1" Then
					Msgbox saveMsgG1, 64, SaveTitle
					continue = False
					docWasSaved = False
				Elseif privateDefaultvalue(0) = "" And doc.getitemvalue("Confidential")(0) &lt;&gt; "" Then
					Msgbox saveMsgG2, 64, SaveTitle
					continue = False
					docWasSaved = False
				Elseif privateDefaultvalue(0) = doc.getitemvalue("Confidential")(0)  Then
					Call doc.replaceitemvalue("$DPLocked", dplocked)
				End If		
			Else 
			'not locked; set $DPLocked to null
				Call doc.replaceitemvalue("$DPLocked", "")
			End If
			
		End If	
		
	End If
	
End Sub
'++LotusScript Development Environment:2:2:Postsave:1:12
Sub Postsave(Source As Notesuidocument)
	Dim s As New notessession
	Dim uiwork As New notesuiworkspace
	Set note = uiwork.currentdocument.document
	Set db = s.currentdatabase
	Set view = db.getview("($VIMPeople)")
	
	memberList = note.getitemvalue("Members")
	gTitle = note.getitemvalue("ListName")(0)	
	
	If note.hasitem("tmpNewGroup") Then		
		Call note.removeitem("tmpNewGroup")
	End If	
	
	'check each member to see if there is a contact record for him/her
	Forall x In memberList
		gcount = 0
		Set contactNote = view.getdocumentbykey(x)
		
		If contactNote Is Nothing Then
			Goto nextMember
		End If
		
		
		'check Groups field to see if it already has this group		
		contactGroup = contactnote.getitemvalue("Groups")
		
		If contactGroup(0) = "" Then  'if there is no Groups item, create it for the first time
			Call contactNote.replaceitemvalue("Groups", gTitle)		
			Call contactNote.save(False,False)
			Goto nextMember
		Else
			'if Groups item already exists, check to see if this group is already listed; if not, append it to the list
			Forall y In contactGroup  
				If Lcase(y) = Lcase(gTitle) Then
					gcount = gcount + 1
				End If		
				If gCount &gt; 0 Then
					Goto nextMember
				End If
			End Forall
		End If
		If gCount = 0 Then
			Set currentGroups = contactNote.getFirstItem("Groups")	
			Call currentGroups.appendtotextlist(gTitle)
			Call contactNote.save(False,False)
		End If					
		
nextMember:
	End Forall
	
End Sub
'++LotusScript Development Environment:2:2:Postrecalc:1:12
Sub Postrecalc(Source As Notesuidocument)
	
End Sub
'++LotusScript Development Environment:2:2:legacyCategory:1:8
Sub legacyCategory(note As notesdocument)
	
	oldCat = note.getitemvalue("ListCategory")
	newCat = note.getitemvalue("Categories")
	savedUpd = note.getitemvalue("SavedUpdate")
	If Not note.isnewnote And oldCat(0)  &lt;&gt; "" And newCat(0) = "" And savedUpd(0) = "" Then
		Call note.replaceitemvalue("Categories", oldCat)
	End If
End Sub
'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Set note = source.document
	Call LegacyCategory(note)
	
	'iNotes  contact compatibility
	'if confidential contact was created in iNotes  and never saved in Notes, do not show as confidential in Notes client
	Call CheckDWAConf(source, note)
	
	'checking policy for Private Contacts
	Dim session As New notessession
	Dim db As notesdatabase
	Set db = session.currentdatabase
	If source.editmode Then
		
		If Not note.isnewnote And note.hasitem("tmpNewGroup") Then
			If note.getitemvalue("tmpNewGroup")(0) = "1" Then
				Call note.replaceitemvalue("tmpNewGroup", "")
			End If			
		End If
		
		Dim profile As notesdocument
		Set profile = db.getprofiledocument("DirectoryProfile")
		policyNotLocked = False
		
		If Not (profile Is Nothing) Then
			
			If Lcase(profile.getitemvalue("Owner")(0)) = Lcase(session.UserName) Then
				If Not CheckPrivatePolicyLocked_Form(session, note, Profile) 	Then
					policyNotLocked = True
					If note.isnewnote Or note.hasitem("IsNewDoc")  Then
						Call ActivatePrivateDefaultPolicy(session, db, Profile, dpdoc, note)
					End If
				End If		
			End If				
			
			If note.hasitem("$DPLocked") And policyNotLocked = True Then
				Call note.replaceitemvalue("$DPLocked", "")
			End If
		End If
		
		Call source.refresh
	End If
	
End Sub
'++LotusScript Development Environment:2:2:Postmodechange:1:12
Sub Postmodechange(Source As Notesuidocument)
	Call LegacyCategory(note)
	
	'iNotes  contact compatibility
	'if confidential contact was created in iNotes  and never saved in Notes, do not show as confidential in Notes client
	Call CheckDWAConf(source, note)
	
	If source.editmode Then
		Dim session As New notessession
		Set dpdoc = session.getUserPolicySettings("", session.username,POLICYSETTINGS_DESKTOP)
		
		Dim uidoc As notesuidocument
		Set uidoc = source
		Dim doc As notesdocument
		Set doc = uidoc.document
		
		If Not doc.isnewnote And doc.hasitem("tmpNewGroup") Then
			If doc.getitemvalue("tmpNewGroup")(0) = "1" Then
				Call doc.replaceitemvalue("tmpNewGroup", "")
			End If			
		End If		
		
		Call PDFormPostModeChange(uidoc, doc , dpdoc)
		
	End If
	
	
	
End Sub
'++LotusScript Development Environment:2:2:Querymodechange:1:12
Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
	dpabForm = source.document.getitemvalue("form")	
	If (Not source.editmode And ViewStrCheck &gt; 0) Or source.inpreviewpane Or Lcase(dpabform(0)) = "dpabgroup" Then		
		Msgbox EditGroupMsg, 64, recentTitle
		continue = False
	End If
	
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Dim uiw As New notesuiworkspace
	Set currentview = uiw.currentview
	
	If currentview Is Nothing Then
		Exit Sub
	Else
		vName = currentview.viewalias	
	End If
	
	ViewStrCheck = Instr(Lcase(vName), Lcase("collab")) 
	
	Dim session As New notessession
	Evar = session.getenvironmentstring("ng")
	
	If source.editmode And ViewStrCheck &gt; 0 And Evar &lt;&gt; "1" Then
		Msgbox EditGroupMsg, 64, recentTitle
		continue = False
	End If
	
	
End Sub<break/></text></item>
