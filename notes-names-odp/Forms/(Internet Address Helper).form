<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub parseInt(address As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim int2 As String
'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
End Sub

'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Dim s As New notessession
	envEmail$ = s.getenvironmentstring("$CItem")
	
	Select Case Lcase(envEmail$)
	Case Is = "email_1"
		e1 = source.document.getitemvalue("email_1")		
		Call ParseInt(e1)
		Call source.document.replaceitemvalue("InternetAddress", int2)		
	Case Is = "miscphone1"
		e1 = source.document.getitemvalue("miscphone1")
		Call ParseInt(e1)		
		Call source.document.replaceitemvalue("InternetAddress", int2)
	Case Is = "mobileEmail"
		e1 = source.document.getitemvalue("mobileEmail")
		Call ParseInt(e1)		
		Call source.document.replaceitemvalue("InternetAddress", int2)		
	Case Is = "miscphone2"
		e1 = source.document.getitemvalue("miscphone2")
		Call ParseInt(e1)		
		Call source.document.replaceitemvalue("InternetAddress", int2)	
	Case Is = "miscphone3"
		e1 = source.document.getitemvalue("miscphone3")
		Call ParseInt(e1)		
		Call source.document.replaceitemvalue("InternetAddress", int2)	
	Case Is = "email_5"
		e1 = source.document.getitemvalue("email_5")
		Call ParseInt(e1)		
		Call source.document.replaceitemvalue("InternetAddress", int2)	
	End Select		
	
End Sub
'++LotusScript Development Environment:2:2:parseInt:1:8
Sub parseInt(address As Variant)
	
'if email is enclosed in brackets [rfc822], then parse out internet address only
	brack1 = Instr(address(0), "&lt;")		
	If brack1 &gt; 0 Then
		int1 = Right( address(0),  Len(address(0)) - brack1)
		int2 = Left(  int1, Len(int1) - 1)
	Else
		int2 = address(0)
	End If
	
End Sub<break/></text></item>
