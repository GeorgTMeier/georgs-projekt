<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66
Option Public

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub RefreshFields

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:RefreshFields:1:8
Sub RefreshFields
	Dim uiwork As New notesuiworkspace
	Call uiwork.currentdocument.refresh
End Sub<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
End Sub

'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	
	'add num
	
	'if case user has changed the phone numbers, put these [new] numbers into the appropriate fields]
	'For legacy reasons, we are using the same field names as were used in prior Notes releases
	ph1 = source.document.getitemvalue("OfficePhoneNumber") 'legacy field;do not rename
	ph2 = source.document.getitemvalue("OfficeFAXPhoneNumber") 'legacy field;do not rename
	ph3 = source.document.getitemvalue("CellPhoneNumber") 'legacy field;do not rename
	ph4 = source.document.getitemvalue("PhoneNumber_6")  'this is a legacy field; so it appears out of order; really phone # 4 
	ph5 = source.document.getitemvalue("PhoneNumber") 'legacy field;do not rename
	ph6a = source.document.getitemvalue("HomeFaxPhoneNumber") 'legacy field;do not rename
	ph7 = source.document.getitemvalue("PersPager") 'legacy field;do not rename
	ph8 = source.document.getitemvalue("PhoneNumber_8")
	ph9 = source.document.getitemvalue("PhoneNumber_9")
	ph10 = source.document.getitemvalue("PhoneNumber_10")
	
	
	If ph1(0) &lt;&gt; "" Then				
		Call source.document.replaceitemvalue("phone_1", ph1)
	Elseif ph1(0) = "" Then
		Call source.document.replaceitemvalue("phone_1", "")
	End If
	
	If ph2(0) &lt;&gt; "" Then		
		Call source.document.replaceitemvalue("phone_2", ph2)
	Elseif ph2(0) = "" Then
		Call source.document.replaceitemvalue("phone_2", "")	
	End If
	
	If ph3(0) &lt;&gt; "" Then		
		Call source.document.replaceitemvalue("phone_3", ph3)
	Elseif ph3(0) = "" Then
		Call source.document.replaceitemvalue("phone_3", "")
	End If
	
	If ph4(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_4", ph4)
	Elseif ph4(0) = "" Then
		Call source.document.replaceitemvalue("phone_4", "")
	End If
	
	If ph5(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_5", ph5)
	Elseif ph5(0) = "" Then
		Call source.document.replaceitemvalue("phone_5", "")
	End If
	
	If ph6a(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_6a", ph6a)
	Elseif ph6a(0) = "" Then
		Call source.document.replaceitemvalue("phone_6a", "")
	End If
	
	If ph7(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_7", ph7)
	Elseif ph7(0) = "" Then
		Call source.document.replaceitemvalue("phone_7", "")
	End If
	
	If ph8(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_8", ph8)
	Elseif ph8(0) = "" Then
		Call source.document.replaceitemvalue("phone_8", "")
	End If
	
	If ph9(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_9", ph9)
	Elseif ph9(0) = "" Then
		Call source.document.replaceitemvalue("phone_9", "")
	End If
	
	If ph10(0) &lt;&gt; "" Then
		Call source.document.replaceitemvalue("phone_10", ph10)
	Elseif ph10(0) = "" Then
		Call source.document.replaceitemvalue("phone_10", "")
	End If
	
	Call source.refresh
	
	Call source.gotofield("Phone_1")
End Sub<break/></text></item>
