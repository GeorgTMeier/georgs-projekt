<item name='$TITLE'><text>($NetworkDialup Wizard)</text></item>
<item name='$INFO' sign='true'>
<rawitemdata type='1'>
hhgBAIAAAAAAgAAADwAJAMDAwAAAAAAA
</rawitemdata></item>
<item name='$Flags'><text>DC</text></item>
<item name='$DesignerVersion' sign='true'><text>8.5</text></item>
<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "Wizard"
Use "RLANRoutines"
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class ConnectionWizard As Wizard
Declare Function RepeatedConnectionID(Destination As Variant)  As String

'++LotusScript Development Environment:2:5:(Declarations):0:10
Dim wiz As Wizard

Const xxstr1="Please enter the organizational hierarchy for the group of servers you want to connect to."
Const xxstr2="Please enter the remote access server name."
Const xxstr3="Please select a Dial-Up Networking entry."
Const xxstr4="Please enter the phone number for the server you want to connect to."
Const xxstr5="Repeated connection"
Const xxstr6= "Configuration already exists. Do you want to create another one?"
Const xxstr7="An error has occurred creating the Network Dialup connection document. Please see your system administrator."
Const xxstr8="Please enter the name of the Passthru server."
Const xxstr9="An error has occurred creating the Passthru connection document. Please see your system administrator."
Const xxstr10="You have successfully created the connection document(s)."

Class ConnectionWizard As Wizard
	
	Sub new( uidoc As NotesUIdocument, tableName As String, firstPanel As String)
	End Sub
	
	Function processNext( note As NotesDocument, currentPanel As String) As String
		If currentPanel="a" Then
			processNext="b"
			
		Elseif currentPanel = "b" And note.GetItemValue("ConnectChoice")(0)="1" Then
			processNext = "c"
			
		Elseif currentPanel = "b" And note.GetItemValue("ConnectChoice")(0)="2" Then
			If note.GetitemValue("ApplyToServer")(0)= "2" And Len(note.GetitemValue("ServerGroup")(0))=0 Then 
				Msgbox xxstr1
				Error WIZ_PROCESS_NEXT_ERROR
			End If
			If note.GetitemValue("ApplyToServer")(0)= "3" And Len(note.GetitemValue("SpecificName")(0))=0 Then 			
				Msgbox xxstr2
				Error WIZ_PROCESS_NEXT_ERROR
			End If				
			processNext = "e"
		Elseif currentPanel = "c" And note.getItemValue( "AccessLAN")(0) = "1" Then
			processNext = "d"
		Elseif currentPanel = "c" And note.getItemValue( "AccessLAN")(0) = "2" Then
			processNext = "e"
		Elseif currentpanel="d" Then
			processNext ="e"
		Else 
			If note.getItemValue( "DunEntries")(0) = "" Then
				Messagebox xxstr3
				Error WIZ_PROCESS_NEXT_ERROR
			End If	
			
			activateNextButton False
			processNext = "f"
	'to pull phone number(s) for selected DUN entry			
			Dim vListEntry As Variant
			Dim vphone As Variant
			Dim ws As New NotesUIWorkspace
			vlistEntry=note.GetitemValue("DUNEntries")
			If Len(vListEntry(0))&lt;&gt;0 Then			
				vphone = ws.Get_DialEntry_Info("RAS", vListEntry(0))
				Call note.replaceitemvalue("tmpPhoneNumber", vphone(0))
				Call note.replaceitemvalue("tmpAreaCode", vphone(1))
				Call note.replaceitemvalue("tmpCountryCode", vphone(2))
			End If			
		End If
		
	End Function
	
	Function processComplete( note As Notesdocument, currentPanel As String) As Integer
		On Error  Goto errhandle
		
		Dim w As New NotesUIWorkspace
		Dim s As New NotesSession
		Dim db As NotesDatabase
		Dim  doc As NotesDocument
		Dim  newdoc As NotesDocument
		Dim iPassthruServerName As NotesItem
		Dim iDominoOrganizationName As NotesItem
		Dim iPassthruServerHostName As NotesItem
		Dim iLocationName As NotesItem
		Dim iLocationType As NotesItem
		Dim itmpPhoneNumber As NotesItem
		Dim itmpAreaCode As NotesItem
		Dim itmpCountryCode As NotesItem
		Dim itmpLoginName As NotesItem
		Dim itmpPassword As NotesItem
		Dim iDUNEntries As NotesItem
		Dim iServiceType As NotesItem
		Dim iPortInternet As NotesItem
		Dim iPortsRAS As NotesItem
		Dim iConnectChoice As Notesitem
		Dim iApplyToServer As NotesItem
		Dim iOptNetworkAddress As NotesItem
		Dim success As Variant
		Dim vDriverList() As Variant
		Dim vDrivers() As Variant
		Dim vDisplayList() As Variant
		Dim destination As String
		
		Set db=s.CurrentDatabase
		Set doc=note
		
			' get items from a dialog box
		Set iPassthruServerName=doc.GetFirstItem("servername") 
		Set iDominoOrganizationName=doc.GetFirstItem("DominoOrganizationName") 
		Set iPassthruServerHostName=doc.GetFirstItem("PassthruServerHostName") 
		Set itmpAreaCode=doc.GetFirstitem("tmpAreaCode")
		Set itmpCountryCode=doc.GetFirstitem("tmpCountryCode")
		Set itmpPhoneNumber=doc.GetFirstitem("tmpPhoneNumber")
		If Len(itmpPhoneNumber.Text)=0 Then
			Msgbox xxstr4
			Exit Function
		End If
		Set itmpLoginName=doc.GetFirstitem("tmpLoginName")
		Set itmpPassword=doc.GetFirstitem("tmpPassword")
		Set iDUNEntries=doc.GetFirstItem("DUNEntries")
		Set iServiceType=doc.GetFirstItem("ServiceType")
		Set iPortsRAS=doc.GetFirstItem("PortsRAS")
		Set iPortInternet=doc.GetFirstItem("PortInternet")		
		Set iLocationType=doc.GetFirstItem("LocationType")
		Set iLocationName=doc.GetFirstItem("Name")
		Set iConnectChoice =doc.GetFirstitem("ConnectChoice")		
		Set iApplyToServer =doc.GetFirstitem("ApplyToServer")		
		Set iOptNetworkAddress = doc.GetFirstitem("OptNetworkAddress")
		
	'find destination (*, */servergroup or specific server) based on ConnectChoice and ApplyToServer 	
		
		If iConnectChoice.Text="2" And iApplyToServer.Text="2"Then
			destination=note.GetitemValue("ServerGroup")(0)
		Elseif	iConnectChoice.Text="2" And iApplyToServer.Text ="3"Then
			destination=note.GetitemValue("SpecificName")(0)
		Else
			destination="*"
		End If
		
'create Network Dialup connection
		Set newdoc=New NotesDocument(db)
		Call newdoc.ReplaceItemValue("Form","Connection")
		Call newdoc.ReplaceItemValue("ConnectionType","5")
		Call newdoc.ReplaceItemValue("ConnectionRecordFirst","1")
		Call newdoc.ReplaceItemValue("Destination", destination)
		Call newdoc.ReplaceitemValue("RLANItems", 6)
		
		Call GetRLANList(newdoc, vDriverList, vDrivers, vDisplayList)
		
		Call newdoc.ReplaceItemValue("DisplayDriverList", vDriverList)
		
'based on ConnectChoice, select port(s) and Network Address to use for LanPortName field on server connection doc			
		If iConnectChoice.Text="1" Then
			Call iPortInternet.CopyItemToDocument(newdoc, "LanPortName")
			Call iPassthruServerHostName.CopyItemToDocument(newdoc,"OptionalNetworkAddress")  			
		Else 
			If Len(iOptNetworkAddress.Text)&lt;&gt;0 And Len(iPortsRAS.Text)=0 Then
				Msgbox "You must supply a specific Port Name if you want to use a Destination Network Address."				
				Exit Function				
			End If			
			Call iPortsRAS.CopyItemToDocument(newdoc, "LanPortName")
			Call iOptNetworkAddress.CopyItemToDocument(newdoc,"OptionalNetworkAddress")  
		End If			
		Call iDUNEntries.CopyItemToDocument(newdoc,"RLANTag")  
		Call newdoc.ReplaceItemValue("RLAN3",  itmpPhoneNumber.Text)
		Call newdoc.ReplaceItemValue("RLAN4", itmpAreaCode.Text)
		Call newdoc.ReplaceItemValue("RLAN5", itmpCountryCode.Text)
		Call itmpLoginName.CopyItemToDocument(newdoc,"RLAN1")  
		Call itmpPassword.CopyItemToDocument(newdoc,"RLAN2")  
		Call iServiceType.CopyItemToDocument(newdoc,"RemoteLanService")
		Call iLocationName.CopyItemToDocument(newdoc,"ConnectionLocation")  
		
'set values for StaticTag field
		If iServiceType.Text="RAS" Then
			Call newdoc.ReplaceItemValue("StaticTag", "RAS$%^Remote connection name:")
		Else 
			Call newdoc.ReplaceItemValue("StaticTag", "ARA$%^Connection document location:")
		End If
		
			'Check for repeated connection
		Dim answer As Integer
		Dim docID As String
		
		docID=RepeatedConnectionID("*")
		
		If docID&lt;&gt;"not found" Then 
			
			answer=w.Prompt(prompt_yesno, xxstr5, xxstr6)
			
			If answer =0 Then Exit Function
		End If		
	'end repeat connection check 		
		
		success= newdoc.ComputeWithForm(False, False) 
		If success Then
			Call newdoc.save(True, True)
		Else
			Msgbox xxstr7
			Exit Function
		End If
'end create Network Dialup connection
		
		
'if AccessLAN =yes("1"), create Passthru connection
		If note.GetitemValue("AccessLAN")(0)="1" Then
			
			If Len(iPassthruServerName.Text) = 0 Then
				Msgbox xxstr8
				
			Else 
				Set newdoc=New NotesDocument(db) 
				If newdoc Is Nothing Then Msgbox "No Document"
				Call newdoc.ReplaceItemValue("Form","Connection")
				Call newdoc.ReplaceItemValue("ConnectionType","2")
				Call newdoc.ReplaceItemValue("ConnectionRecordFirst","1")
				Call newdoc.ReplaceItemValue("Destination", "*/"+iDominoOrganizationName.Text)
				Call iLocationName.CopyItemToDocument(newdoc,"ConnectionLocation")
				Call iPassthruServerName.CopyItemToDocument(newdoc,"PassthruServer")  
				
				success= newdoc.ComputeWithForm(False, False) 
				If success Then
					Call newdoc.save(True, True)
				Else
					Msgbox xxstr9  
					Exit Function
				End If
			End If
		End If
'end create Passthru connection
		
		processComplete = True
		Msgbox xxstr10
		Exit Function
		
errhandle:
		Messagebox "Error: (" &amp; Err &amp; "): " &amp; Error$	
		
	End Function
	
End Class
'++LotusScript Development Environment:2:1:RepeatedConnectionID:1:8
Function RepeatedConnectionID(Destination As Variant)  As String
	Dim s As New NotesSession	
	Dim w As New NotesUIWorkspace
	Dim db As NotesDatabase
	Dim key(0) As String
	Dim view As NotesView
	Dim uidoc As NotesUIdocument
	Dim doc As NotesDocument
	Dim doc2 As NotesDocument
	Dim helpdoc As NotesDocument
	Dim connectiontype As String
	Dim locationtype As String
	Dim done As Integer
	RepeatedConnectionID="not found"
	Set db=s.CurrentDatabase
	Set uidoc=w.CurrentDocument
	Set doc=uidoc.Document
	Set view=db.GetView("($Connections)")
	done=False	
	key(0)=s.Username
	Set doc2=view.GetDocumentByKey(key,False)
	
	If doc2 Is Nothing Then Exit Function
	
	
	While Not done 
		If destination=doc2.ColumnValues(2) Then
			If doc2.ColumnValues(0)=key(0) Then 				
				RepeatedConnectionID=doc2.NoteID
				Exit Function
			End If
		End If
		Set helpdoc=doc2
		Set doc2=view.GetNextDocument(helpdoc)
		If doc2 Is Nothing Then Exit Function
		If doc2.ColumnValues(0)&lt;&gt;key(0) Then done=True
	Wend
End Function<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Declare
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
Declare Sub Queryclose(Source As Notesuidocument, Continue As Variant)
Declare Sub Postrecalc(Source As Notesuidocument)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
	On Event Queryopen From Source Call Queryopen
	On Event Queryclose From Source Call Queryclose
	On Event Postrecalc From Source Call Postrecalc
End Sub

'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Dim ws As New notesuiworkspace	
	Dim doc As NotesDocument
	Dim x As Long
	Dim Drivers() As Variant
	Dim DriverList() As Variant
	Dim DisplayList() As Variant
	Dim port As Variant
	
	Set doc = source.document
	
	On Error  Goto errhandle
	
'get values for DispalyDriverList  which is used in keyword ServiceType fieled
	Call GetRLANList(doc, DriverList, Drivers, DisplayList)
	
	doc.DisplayDriverList =  DriverList
	doc.OriginalService = doc.ServiceType
	
	Exit Sub
errhandle:
	Messagebox "Err (" &amp; Err &amp; "): " &amp; Error$	
	Exit Sub
	
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Dim firstPanel As String
	Dim ws As New NotesUIWorkspace		
	Dim vList As Variant
	Dim doc As NotesDocument
	
	
	
'Make sure to pass to first panel you want displayed
	firstPanel = "a"
	
	On Error  Goto errhandle
	
	Set wiz = New ConnectionWizard( source, "Wiz", "a")
	
	'to populate DUNList which used for DUNEntries choices
	Set doc = source.document
	vList = ws.Get_DialEntry_List("RAS")	
	Call doc.replaceitemvalue("DUNList",vList)	
	
	Exit Sub
	
errhandle:
	Messagebox "Err (" &amp; Err &amp; "): " &amp; Error$	
	Exit Sub
	
End Sub
'++LotusScript Development Environment:2:2:Queryclose:1:12
Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	continue = confirmClose( source)
End Sub
'++LotusScript Development Environment:2:2:Postrecalc:1:12
Sub Postrecalc(Source As Notesuidocument)
	
End Sub<break/></text></item>
