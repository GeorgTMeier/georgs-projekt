<item name='$$OfficePhoneNumber_1' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66


'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Exiting(Source As Field)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As FIELD
	Set Source = Bind(Objectname_)
	On Event Exiting From Source Call Exiting
End Sub

'++LotusScript Development Environment:2:2:Exiting:1:12
Sub Exiting(Source As Field)
	F=Evaluate(|@False|)
	T=Evaluate(|@True|)
	
	Dim doc As Notesdocument
	Set doc = uidoc.Document
	
	strFieldName = "OfficePhoneNumber"
	strPhoneNumber = doc.GetItemValue("OfficePhoneNumber")(0)
	
	If strPhoneNumber &lt;&gt; "" Then
		Call ParsePhoneNumber2(strPhoneNumber, strFieldName)
		Call uidoc.refresh
	End If
End Sub<break/></text></item>
