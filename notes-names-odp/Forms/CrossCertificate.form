<item name='$WINDOWTITLE' sign='true'><formula>_names := "Vault Trust Certificate" : "Password Reset Certificate" : "Cross Certificate" : "Multi-Factor Authentication Certificate";
_unknownCert := "Unknown Certificate";
_newCert := "New Certificate";
_sTmpMsg := "%s1 for: "+@Name([Abbreviate];IssuedTo)+ " by "+
						@Name([Abbreviate];IssuedBy);
REM {DNT Begin};
_aliases := "VaultTrustCertificate" : "PasswordResetCertificate" : "CrossCertificate" : "MFATrustCertificate";

_type :=
	@If(@IsNewDoc;
		_newCert ;
	Type = _aliases;
		@Replace(Type; _aliases; _names);
     _unknownCert
	);

@ReplaceSubstring(_sTmpMsg; "%s1"; _type)</formula></item>
<item name='$HTMLHeadTag' sign='true'><formula>REM {DNT Begin};
