<item name='$Script' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class UIAddressHelper

'++LotusScript Development Environment:2:5:(Declarations):0:10
Const CONFLICT_MESSAGE$ = "This entry is already in My Contacts."
Dim AddressControl As UIAddressHelper
'Begin DNT
Class UIAddressHelper
	Private m_uiws As notesuiworkspace	
	Private m_uidocDialog As notesuidocument
	Private m_noteDialog As notesdocument
	Private m_vAllAddresses As Variant
	Private m_vAllNoteIDs  As Variant
	Private m_vAllTitle As Variant
	Private m_vAllFirst As Variant
	Private m_vAllMiddle As Variant
	Private m_vAllLast As Variant	
	Private m_vAllSuffix As Variant	
	Private m_vAllCompany As Variant 	
	Private m_vAllEmail As Variant
	Private m_vAllEmailType As Variant	
	Private m_vAllDomain As Variant
	Private m_vAllCity As Variant
	Private m_vAllAltNames As Variant  
	Private m_vAllFullNameLang As Variant
	Private m_vAllInetNames As Variant
	
	Private m_vAllOfficephone As Variant
	Private m_vAllHomephone As Variant 
	Private m_vAllCellphone As Variant 
	Private m_vAllFullName As Variant
	Private m_nMAX As Integer
	Private m_nBottom As Integer
	Private m_nCurrentSelection As Integer
	
Declare Public Sub Init(Source As notesuidocument)
Declare Public Function WriteRecords() As Integer
Declare Public Sub Next()
Declare Public Sub Previous()
Declare Private Sub LoadDisplay()
Declare Private Sub WriteUIToStack()
	
	Sub New()
		Set Me.m_uiws = New notesuiworkspace
	End Sub
	
	
	Sub Init(Source As notesuidocument)
		Set Me.m_uidocDialog = Source
		Set Me.m_noteDialog = Source.document
		
		Me.m_vAllAddresses = Me.m_noteDialog.getitemvalue("AllAddresses")
		Me.m_vAllNoteIDs  = Me.m_noteDialog.getitemvalue("AllNoteIDs")		
		Me.m_vAllTitle = Me.m_noteDialog.getitemvalue("AllTitle")
		Me.m_vAllFirst = Me.m_noteDialog.getitemvalue("AllFirst")
		Me.m_vAllMiddle = Me.m_noteDialog.getitemvalue("AllMiddle")
		Me.m_vAllLast = Me.m_noteDialog.getitemvalue("AllLast")		
		Me.m_vAllSuffix = Me.m_noteDialog.getitemvalue("AllSuffix")		
		Me.m_vAllCompany = Me.m_noteDialog.getitemvalue("AllCompany") 		
		Me.m_vAllEmail = Me.m_noteDialog.getitemvalue("AllEmail")
		Me.m_vAllCity = Me.m_noteDialog.getitemvalue("AllCity")		
		Me.m_vAllEmailType = Me.m_noteDialog.getitemvalue("AllEmailType")		
		Me.m_vAllDomain = Me.m_noteDialog.getitemvalue("AllDomain")
		Me.m_vAllOfficephone = Me.m_noteDialog.getitemvalue("AllOfficephone") 
		Me.m_vAllHomephone = Me.m_noteDialog.getitemvalue("AllHomephone") 
		Me.m_vAllCellphone = Me.m_noteDialog.getitemvalue("AllCellphone") 
		Me.m_vAllFullName = Me.m_noteDialog.getitemvalue("AllFullName")		
		
		Me.m_vAllAltNames = Me.m_noteDialog.getitemvalue("AllAltNames") 'NEW
		
		
		Me.m_nBottom = 0
		Me.m_nMAX = Ubound(Me.m_vAllAddresses)
		Me.m_uidocDialog.autoreload = False
		Call Me.m_noteDialog.ReplaceItemValue("TotalRecords",Me.m_nMAX+1)
		Call LoadDisplay()
	End Sub
	
	Sub Next()
		If Me.m_nCurrentSelection &lt; Me.m_nMAX Then
			Call WriteUIToStack()
			Me.m_nCurrentSelection = Me.m_nCurrentSelection + 1			
			Call LoadDisplay()				
		Else 
			Beep
		End If
	End Sub	
	
	Sub Previous()
		If Me.m_nCurrentSelection &gt; 0 Then
			Call WriteUIToStack()			
			Me.m_nCurrentSelection = Me.m_nCurrentSelection - 1			
			Call LoadDisplay()				
		Else 
			Beep
		End If
	End Sub
	
	Sub LoadDisplay()
		Call Me.m_noteDialog.ReplaceItemValue("tmpAltNames",Me.m_vAllAltNames(Me.m_nCurrentSelection))  
		
		Call Me.m_noteDialog.ReplaceItemValue("tmpTitle",Me.m_vAllTitle(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpFirstName",Me.m_vAllFirst(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpMiddleName",Me.m_vAllMiddle(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpLastName",Me.m_vAllLast(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpSuffix",Me.m_vAllSuffix(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpCompany",Me.m_vAllCompany(Me.m_nCurrentSelection))  		
		If (Instr(Me.m_vAllEmail(Me.m_nCurrentSelection) , "(") &gt; 0 And Instr(Me.m_vAllEmail(Me.m_nCurrentSelection) , ")") &gt; 0) Then 
			Dim tmpfname1 As String
			Dim tmpfname2 As String
			tmpfname1 = Mid (Me.m_vAllEmail(Me.m_nCurrentSelection), 1, Instr(Me.m_vAllEmail(Me.m_nCurrentSelection), "(" )  - 1) 
			tmpfname2 = tmpfname1 + Mid (Me.m_vAllEmail(Me.m_nCurrentSelection),  Instr(Me.m_vAllEmail(Me.m_nCurrentSelection), ")" )  + 1, Len(Me.m_vAllEmail(Me.m_nCurrentSelection))) 			
			Call Me.m_noteDialog.ReplaceItemValue("tmpEmailAddress",tmpfname2)
		End If		
		
		Call Me.m_noteDialog.ReplaceItemValue("tmpCity",Me.m_vAllCity(Me.m_nCurrentSelection))		
		Call Me.m_noteDialog.ReplaceItemValue("tmpOfficephone",Me.m_vAllOfficephone(Me.m_nCurrentSelection))  
		Call Me.m_noteDialog.ReplaceItemValue("tmpHomephone",Me.m_vAllHomephone(Me.m_nCurrentSelection))  
		Call Me.m_noteDialog.ReplaceItemValue("tmpCellphone",Me.m_vAllCellphone(Me.m_nCurrentSelection))  
		
		Call Me.m_noteDialog.ReplaceItemValue("tmpDomain",Me.m_vAllDomain(Me.m_nCurrentSelection))
		Call Me.m_noteDialog.ReplaceItemValue("tmpEmailType",Me.m_vAllEmailType(Me.m_nCurrentSelection))		
		
		
		Call Me.m_uidocDialog.Reload()
		Call Me.m_uidocDialog.Refreshhideformulas()
	End Sub
	
	Sub WriteUIToStack()
		Me.m_vAllTitle(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpTitle")(0)
		Me.m_vAllFirst(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpFirstName")(0)
		Me.m_vAllMiddle(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpMiddleName")(0)
		Me.m_vAllLast(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpLastName")(0)
		Me.m_vAllSuffix(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpSuffix")(0)
		Me.m_vAllCompany(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpCompany")(0) 		
		Me.m_vAllEmail(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpEmailAddress")(0)
		Me.m_vAllCity(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpCity")(0)		
		Me.m_vAllOfficephone(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpOfficephone")(0) 
		Me.m_vAllHomephone(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpHomephone")(0) 
		Me.m_vAllCellphone(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpCellphone")(0) 
		
		Me.m_vAllEmailType(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpEmailType")(0)				
		Me.m_vAllDomain(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpDomain")(0)		
		Me.m_vAllAltNames(Me.m_nCurrentSelection) = Me.m_noteDialog.GetItemValue("tmpAltNames")(0)		 'NEW	
		Me.m_vAllFullNameLang = Me.m_noteDialog.getitemvalue("AllAltFullNameLang")
		Me.m_vAllInetNames = Me.m_noteDialog.getitemvalue("AllInetNames")
		
	End Sub
	
	Public Function WriteRecords() As Integer
		Call WriteUIToStack()
		With Me.m_noteDialog
			Call .ReplaceItemValue("AllAddresses",	Me.m_vAllAddresses)
			Call .ReplaceItemValue("AllNoteIDs", Me.m_vAllNoteIDs  )		
			Call .ReplaceItemValue("AllTitle", Me.m_vAllTitle )
			Call .ReplaceItemValue("AllFirst", Me.m_vAllFirst )
			Call .ReplaceItemValue("AllMiddle", Me.m_vAllMiddle )
			Call .ReplaceItemValue("AllLast", Me.m_vAllLast )
			Call .ReplaceItemValue("AllSuffix", Me.m_vAllSuffix )
			Call .ReplaceItemValue("AllCompany", Me.m_vAllCompany ) 
			Call .ReplaceItemValue("AllCity", Me.m_vAllCity )
			Call .ReplaceItemValue("AllOfficePhone", Me.m_vAllOfficephone ) 
			Call .ReplaceItemValue("AllHomePhone", Me.m_vAllHomephone ) 
			Call .ReplaceItemValue("AllCellPhone", Me.m_vAllCellphone ) 
			Call .ReplaceItemValue("AllFullName", Me.m_vAllFullName )
			
			Call .ReplaceItemValue("AllEmail", Me.m_vAllEmail )
			Call .ReplaceItemValue("AllDomain", Me.m_vAllDomain )
			
			Call .ReplaceItemValue("AllAltNames", Me.m_vAllAltNames )  'NEW
			Call .ReplaceItemValue("AllAltFullNameLang",Me.m_vAllFullNameLang)
			Call .ReplaceItemValue("AllInetNames",Me.m_vAllInetNames)
		End With
		WriteRecords = True
	End Function
End Class<break/></text></item>
<item name='$$FormScript' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Sub Postopen(Source As Notesuidocument)
Declare Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
Declare Sub Queryclose(Source As Notesuidocument, Continue As Variant)
Declare Sub Querysave(Source As Notesuidocument, Continue As Variant)

'++LotusScript Development Environment:2:5:(Declarations):0:2

'++LotusScript Development Environment:2:2:BindEvents:1:129
Private Sub BindEvents(Byval Objectname_ As String)
	Static Source As NOTESUIDOCUMENT
	Set Source = Bind(Objectname_)
	On Event Postopen From Source Call Postopen
	On Event Queryopen From Source Call Queryopen
	On Event Queryclose From Source Call Queryclose
	On Event Querysave From Source Call Querysave
End Sub

'++LotusScript Development Environment:2:2:Postopen:1:12
Sub Postopen(Source As Notesuidocument)
	Call AddressControl.Init(Source) 
	Call source.refresh
End Sub
'++LotusScript Development Environment:2:2:Queryopen:1:12
Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Set AddressControl = New UIAddressHelper
End Sub
'++LotusScript Development Environment:2:2:Queryclose:1:12
Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	If Not Source.DialogBoxCanceled Then
		If source.Document.IsQuickContact(0) ="1" Then
			If source.Document.tmpFirstName(0) = ""  Then
				If source.Document.tmpLastName(0) = "" Then 
					If source.Document.tmpCompany(0) = ""Then
						Msgbox "First name Or Last name Or Company name is required.", 16, "Add Quick Contact"
						Continue = False
						Exit Sub
					End If
				End If
			End If		
		End If 
		Continue = AddressControl.WriteRecords() 
	End If
End Sub
'++LotusScript Development Environment:2:2:Querysave:1:12
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	
End Sub<break/></text></item>
