<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.domino</groupId>
    <artifactId>xrechnung-generator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>HCL Domino X-Rechnung Generator</name>
    <description>Java-Programm für HCL Domino zur Erstellung von X-Rechnung mit Mustang-Bibliothek</description>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <mustang.version>2.16.4</mustang.version>
    </properties>
    
    <dependencies>
        <!-- Mustang Library für X-Rechnung -->
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>library</artifactId>
            <version>${mustang.version}</version>
        </dependency>
        
        <!-- HCL Domino API (wird normalerweise von Domino-Server bereitgestellt) -->
        <!-- Diese Dependency muss lokal verfügbar sein oder als System-Dependency konfiguriert werden -->
        <!--
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>domino</artifactId>
            <version>12.0.0</version>
            <scope>system</scope>
            <systemPath>${domino.path}/jvm/lib/ext/Notes.jar</systemPath>
        </dependency>
        -->
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
